# Data ingestion workflow for the climate services KG.
#
# Run from the repository root, e.g.:
#   snakemake --cores 1                       # mapping (default)
#   snakemake --cores 1 mapping               # all the mappings to the KG
#   snakemake --cores 1 sources_analysis      # all the analyses of the sources (not in the KG)
#   snakemake --cores 1 cf_standard_names     # variables of the CF standard name table
#   snakemake --cores 1 cmor_tables           # variables of the CMOR tables (MIP and previous variables)
#   snakemake --cores 1 cmip5_cvs             # CMIP5 experiments and institutions
#   snakemake --cores 1 cmip5                 # CMIP5 datasets
#   snakemake --cores 1 cordex_domains        # CORDEX-CMIP5 domains and grids
#   snakemake --cores 1 cordex_cmip5          # CORDEX-CMIP5 datasets
#   snakemake --cores 1 ukcp18                # UKCP18 datasets
#   snakemake --cores 1 climdex               # climate indices of Climdex/Climpact
#   snakemake --cores 1 mohc_cvs              # controlled vocabularies of the Met Office Hadley Centre
#   snakemake --cores 1 cmor_tables_analysis  # analysis of all the CMOR tables editions

import json
import os


configfile: "config/config.yaml"


# Eras of the CMOR tables, with their repositories (config["eras"], config["current"])
configfile: "config/cmor-tables-eras.json"


# Git repositories, through snakemake-storage-plugin-git (patched to support a
# git ref as URL fragment, e.g. https://github.com/PCMDI/cmip6-cmor-tables.git#6.9.33)
storage git:
    provider="git",
    keep_local=True,


# Zenodo records, through snakemake-storage-plugin-zenodo. The plugin requires
# an access token, which Zenodo ignores for published records: a placeholder is
# used if none is given (environment variable SNAKEMAKE_STORAGE_ZENODO_ACCESS_TOKEN)
storage zenodo:
    provider="zenodo",
    keep_local=True,
    access_token=os.environ.get("SNAKEMAKE_STORAGE_ZENODO_ACCESS_TOKEN", "anonymous"),


include: "patches/git_storage_plugin.py"


include: "rules/cf_standard_names.smk"


include: "rules/cmor_tables.smk"


include: "rules/cmip5_cvs.smk"


include: "rules/cmip5.smk"


include: "rules/cordex_domains.smk"


include: "rules/cordex_cmip5.smk"


include: "rules/ukcp18.smk"


include: "rules/climdex.smk"


include: "rules/mohc_cvs.smk"


# Mappings of the sources to the KG
rule mapping:
    default_target: True
    input:
        rules.cf_standard_names.input,
        rules.cmor_tables.input,
        rules.cmip5_cvs.input,
        rules.cmip5.input,
        rules.cordex_domains.input,
        rules.cordex_cmip5.input,
        rules.ukcp18.input,
        rules.climdex.input,
        rules.mohc_cvs.input,


# Analyses of the sources
rule sources_analysis:
    input:
        rules.cmor_tables_analysis.output,
        rules.ukcp18_unmapped_variables.output,
        rules.cordex_cmip5_variables_check.output,
        rules.cmip5_cvs_institutions_check.output,
