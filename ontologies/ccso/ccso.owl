            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Vulnerability Type</rdfs:label>
