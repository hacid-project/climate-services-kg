    <!-- https://w3id.org/hacid/onto/ccso/maintains -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/ccso/maintains">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">maintains</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/ccso/potentiallyAssertsVulnerabilityToImpactType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/ccso/potentiallyAssertsVulnerabilityToImpactType">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/ccso/VulnerabilityType"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/ccso/ImpactType"/>
        <rdfs:comment xml:lang="en">Associates a type of vulnerability with an impact type that is potentially asserted in the classified vulnerabilities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">potentially asserts vulnerability to impact type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/ccso/potentiallySuffersImpactType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/ccso/potentiallySuffersImpactType">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/ccso/AssetType"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/ccso/ImpactType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">potentially suffers impact type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/ccso/refersToGlobalWarmingLevel -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/ccso/refersToGlobalWarmingLevel">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isClassifiedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/ccso/GlobalWarmingLevel"/>
        <rdfs:comment xml:lang="en">The object property that allows an entity to refer to a global warming level.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">refers to global warming level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/ccso/refersToScenario -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/ccso/refersToScenario">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isClassifiedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/ccso/EmissionScenario"/>
        <rdfs:comment xml:lang="en">The object property that allows an entity to refer to a scenario.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">refers to scenario</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/ccso/relatedWithPhenomenon -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/ccso/relatedWithPhenomenon">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/ccso/relatedWithPhenomenon"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">related with phenomenon</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/ccso/sufferedImpact -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/ccso/sufferedImpact">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/ccso/Asset"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/ccso/Impact"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">suffered impact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/ccso/suffersImpactType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/ccso/suffersImpactType">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/ccso/Asset"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/ccso/ImpactType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">suffers impact type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/ccso/usesModel -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/ccso/usesModel">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/ccso/ClimateSimulation"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/ccso/ClimateModel"/>
        <rdfs:comment xml:lang="en">The property that allows one to assert that a climate model is used by an experiment to simulate the behavior and evolution of the Earth’s climate system over a specified period.</rdfs:comment>
        <rdfs:comment xml:lang="en">The property that allows one to assert that an experiment uses a climate model to simulate the behavior and evolution of the Earth’s climate system over a specified period.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">uses model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/hacid/onto/ccso/productId -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/ccso/productId">
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/ccso/Projection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">An identifier associated to a specific projection in the context of its production (e.g., a simulation having multiple outputs).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">product ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/hacid/onto/ccso/Aggregation -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/Aggregation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Rescaling"/>
        <rdfs:comment xml:lang="en">A type of projection rescaling in which one or more of the independent variables are rescaled to a lower accuracy and the new values of the dependent variables are computed by aggregation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Aggregation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/Assessment -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/Assessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/core/judgement/Judgement"/>
        <rdfs:comment xml:lang="en">The assessment of a climate change related issue.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/Asset -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/Asset">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Asset</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/AssetType -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/AssetType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/classifies"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/ccso/Asset"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Asset Type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/ClimateModel -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/ClimateModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">A representation of the Earth’s climate system. A model is used to simulate and understand the climate, including its variability and changes over time, by using a set of equations based on physical, chemical, and biological principles.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Climate Model</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/ClimateModelIntercomparisonExperiment -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/ClimateModelIntercomparisonExperiment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/EnsembleProjectionProduction"/>
        <rdfs:comment xml:lang="en">A set of simulations run with the same constraints, using multiple models.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Climate Model Intercomparison Experiment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/ClimatePhenomenon -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/ClimatePhenomenon">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Climate Phenomenon</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/ClimatePhenomenonType -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/ClimatePhenomenonType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/classifies"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/ccso/ClimatePhenomenon"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Climate Phenomenon Type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/ClimateSimulation -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/ClimateSimulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ProjectionProduction"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Simulation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/ccso/usesModel"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/ccso/ClimateModel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A computational experiment that uses a climate model to simulate the behavior and evolution of the Earth’s climate system over a specified period. These simulations are designed to understand how various components of the climate system interact and respond to different forcing factors, such as changes in greenhouse gas concentrations, solar radiation, volcanic activity, and land use.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Climate Simulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/ConvectionPermittingClimateModel -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/ConvectionPermittingClimateModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/LocalClimateModel"/>
        <rdfs:comment xml:lang="en">A local climate model permitting the simulation of convection.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Convection Permitting Climate Model</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/Downscaling -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/Downscaling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Rescaling"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/ccso/isDownscalingOf"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/ccso/ClimateSimulation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A process taking as input the output of a climate simulation and obtaining finer granularity, usually at the cost of reduced geographic coverage.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Downscaling</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/DynamicalDownscaling -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/DynamicalDownscaling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ClimateSimulation"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Downscaling"/>
        <rdfs:comment xml:lang="en">A simulation using as constraint the output of another simulation, run at a coarser granularity (with typically broader coverage): e.g., a regional simulation run using as constraint the output a global simulation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Dynamical Downscaling</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/EmissionScenario -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/EmissionScenario">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:comment xml:lang="en">A projected trajectory of future greenhouse gas emissions, atmospheric concentrations, and corresponding impacts on the climate system. These scenarios are used in climate modeling to explore how different levels of emissions might influence global temperatures, weather patterns, sea level rise, and other climate-related phenomena.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Emission Scenario</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/EnsembleProjection -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/EnsembleProjection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Projection"/>
        <rdfs:comment xml:lang="en">A climate projection composed of multiple single projections, corresponding to different assumptions. They still have aspects in common, usually the same spacetime coverage and resolution, possibly some constraints or the general production method (e.g., a specific model).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Ensemble Projection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/EnsembleProjectionProduction -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/EnsembleProjectionProduction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ProjectionProduction"/>
        <rdfs:comment xml:lang="en">A process that generates a climate projection ensemble.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Projection Ensemble Production</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/EnsembleSimulation -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/EnsembleSimulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Simulation"/>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/ccso/SingleSimulation"/>
        <rdfs:comment xml:lang="en">A simulation that is composed of a set of simulations with a common set of constraints but with one or more dimensions assuming differing values (e.g., multiple models or parameter values).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Ensemble Simulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/GlobalClimateModel -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/GlobalClimateModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ClimateModel"/>
        <rdfs:comment xml:lang="en">A climate model meant to be used to simulate climate at global (Earth) scale.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Global Climate Model</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/GlobalClimateSimulation -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/GlobalClimateSimulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ClimateSimulation"/>
        <rdfs:comment xml:lang="en">A climate simulation run at global scale, i.e. for all the surface of Earth.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Global Climate Simulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/GlobalWarmingLevel -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/GlobalWarmingLevel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:comment xml:lang="en">A global warming threshold specified as global temperature increase in respect to pre-industrial levels.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Global Warming Level</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/GlobalWarmingLevelBasedProjection -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/GlobalWarmingLevelBasedProjection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Projection"/>
        <rdfs:comment xml:lang="en">A climate projection that is located in time with the period in which the global warming level (GWL) is predicted to reach a certain value. The values of the time variable are thus relative to that event, rather than being absolute.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Global Warming Level Based Projection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/GreenhouseGasConcentrationPathway -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/GreenhouseGasConcentrationPathway">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/EmissionScenario"/>
        <rdfs:comment xml:lang="en">These pathways are used to model and predict the impacts of different levels of greenhouse gas emissions on the climate system. They are essential for understanding how different emissions scenarios might influence global temperatures, climate patterns, and related environmental changes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Greenhouse gas concentration pathway</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/HazardType -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/HazardType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ClimatePhenomenonType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Hazard Type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/Impact -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/Impact">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Impact</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/ImpactType -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/ImpactType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/classifies"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/ccso/Impact"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Impact Type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/IndexComputation -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/IndexComputation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ProjectionTransformation"/>
        <rdfs:comment xml:lang="en">A projection transformation such that the dependent variables of the output projection are indices computed on the dependent variables of the input projection.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Index Computation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/LocalClimateModel -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/LocalClimateModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ClimateModel"/>
        <rdfs:comment xml:lang="en">A climate model meant to be used to simulate climate at local scale.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Local Climate Model</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/PerturbedParameterClimateEnsembleSimulation -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/PerturbedParameterClimateEnsembleSimulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/EnsembleProjectionProduction"/>
        <rdfs:comment xml:lang="en">A set of simulations run with the same model and common constraints, variating the values of some parameters.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Perturbed Parameter Climate Ensemble Simulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/ProbabilisticProjection -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/ProbabilisticProjection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Projection"/>
        <rdfs:comment xml:lang="en">A climate projection containing a probability distribution of values for each point in space-time. Such distribution may be represented in multiple ways, including the probability density function (PDF) and the cumulative distribution function (CDF).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Probabilistic Projection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/ProbabilisticProjectionProduction -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/ProbabilisticProjectionProduction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ProjectionProduction"/>
        <rdfs:comment xml:lang="en">A process that generates a probabilistic climate projection.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Probabilistic Projection Production</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/Projection -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/Projection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/data/Dataset"/>
        <rdfs:comment xml:lang="en">A climate projection. It is a dataset with spatio-temporal independent variables and climate-relevant dependent variables. It is associated to some assumptions (e.g., a specific emission scenario).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Projection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/ProjectionProduction -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/ProjectionProduction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/data/DataGeneratingProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/data/hasOutput"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/ccso/Projection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A process that generates a climate projection. It may use climate models (a simulation) or purely statistical means.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Projection Production</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/ProjectionTransformation -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/ProjectionTransformation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ProjectionProduction"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/data/DataTransformation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/data/hasInput"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/ccso/Projection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A process taking as input one or more climate projections and producing as output one or more climate projections.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Projection Transformation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/RegionalClimateModel -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/RegionalClimateModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ClimateModel"/>
        <rdfs:comment xml:lang="en">A climate model meant to be used to simulate climate at regional scale.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Regional Climate Model</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/Request -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/Request">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:comment xml:lang="en">A request (of information) concerning a climate change related issue.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Request</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/Rescaling -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/Rescaling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ProjectionTransformation"/>
        <rdfs:comment xml:lang="en">A projection transformation meant to change the resolution of some dependent variables, with a focus on maintaining the overall structure and relationships within the data.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Rescaling</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/ScenarioBasedProjection -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/ScenarioBasedProjection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Projection"/>
        <rdfs:comment xml:lang="en">A climate projection (for the future) associated with a certain emission scenario.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Scenario Based Projection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/SharedSocioeconomicPathway -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/SharedSocioeconomicPathway">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/EmissionScenario"/>
        <rdfs:comment xml:lang="en">Shared socio-economic Pathways (SSPs) are scenarios developed to describe different trajectories of socioeconomic development, which can influence future greenhouse gas emissions and the ability of societies to mitigate and adapt to climate change. The SSPs are used in climate modeling to explore the interactions between socioeconomic factors, emissions pathways, and climate impacts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Shared socio-economic pathway</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/Simulation -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/Simulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/data/DataGeneratingProcess"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Simulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/SingleProjection -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/SingleProjection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Projection"/>
        <rdfs:comment xml:lang="en">A climate projection containing definite values for each point in space-time (its only independent variables are spatio-temporal), in contrast with ensemble projections and probabilistic projections.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Single Projection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/SingleProjectionProduction -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/SingleProjectionProduction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ProjectionProduction"/>
        <rdfs:comment xml:lang="en">A process that generates a single climate projection.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Single Projection Production</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/SingleSimulation -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/SingleSimulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Simulation"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/SingleProjectionProduction"/>
        <rdfs:comment xml:lang="en">A simulation that is a single run of a model with well specified parameters and conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Single Simulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/SliceExtraction -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/SliceExtraction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Rescaling"/>
        <rdfs:comment xml:lang="en">A type of projection rescaling in which one or more of the independent variables are rescaled so that the (possibly aggregated) value of some independent variable conform to some criteria (e.g., the time slice of a dataset such that the global warming level is 2°C).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Slice Extraction</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/StatisticalDownscaling -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/StatisticalDownscaling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/Downscaling"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/StatisticalProjectionTransformation"/>
        <rdfs:comment xml:lang="en">A statistical process taking as input a climate projection and producing as output a new climate projection having accuracy (usually in respect to the geodetic dimension).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Statistical Downscaling</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/StatisticalProjectionTransformation -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/StatisticalProjectionTransformation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/ccso/ProjectionTransformation"/>
        <rdfs:comment xml:lang="en">A projection transformation performed with statistical methods. This is a catch all definition to distinguish from model-based transformations (e.g., a dynamical downscaling based on a regional climate model).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Statistical Projection Transformation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/Vulnerability -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/Vulnerability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:comment xml:lang="en">The susceptibility of an asset to damage or disruption from a specific hazard, considering factors like exposure, sensitivity, and adaptive capacity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/ccso"/>
        <rdfs:label xml:lang="en">Vulnerability</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/ccso/VulnerabilityType -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/ccso/VulnerabilityType">
