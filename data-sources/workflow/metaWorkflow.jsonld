{
    "@context": {
        "@base": "https://w3id.org/hacid/data/cs/wf/",
        "ops": "https://w3id.org/hacid/data/cs/wf/ops/",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "top": "https://w3id.org/hacid/onto/top-level/",
        "ccso": "https://w3id.org/hacid/onto/ccso/",
        "data": "https://w3id.org/hacid/onto/data/",
        "wf": "https://w3id.org/hacid/data/cs/wf/",
        "tasks": {
            "@id": "top:definesTask",
            "@type": "@id"
        },
        "roles": {
            "@id": "top:definesRole",
            "@type": "@id"
        },
        "label": {
            "@id": "rdfs:label",
            "@language": "en"
        },
        "comment": {
            "@id": "rdfs:comment",
            "@language": "en"
        },
        "range": {
            "@id": "rdfs:range",
            "@type": "@id"
        },
        "isPartOf": {
            "@id": "top:isPartOf",
            "@type": "@id"
        },
        "hasPart": {
            "@id": "top:hasPart",
            "@type": "@id"
        },
        "directlyFollows": {
            "@id": "top:directlyFollows",
            "@type": "@id"
        },
        "directlyPrecedes": {
            "@id": "top:directlyPrecedes",
            "@type": "@id"
        },
        "isTaskOf": {
            "@id": "top:isTaskOf",
            "@type": "@id"
        },
        "isRealizedByPlan": {
            "@id": "top:isRealizedByPlan",
            "@type": "@id"
        },
        "isRealizedByMethod": {
            "@id": "top:isRealizedByMethod",
            "@type": "@id"
        },
        "executedThroughOperation": {
            "@id": "top:executedThroughOperation",
            "@type": "@id"
        },
        "getsDefaultInputFromPlanRole": {
            "@id": "top:getsDefaultInputFromPlanRole",
            "@type": "@id"
        },
        "sendsDefaultOutputToPlanRole": {
            "@id": "top:sendsDefaultOutputToPlanRole",
            "@type": "@id"
        },
        "isSpecializedBy": {
            "@id": "top:isSpecializedBy",
            "@type": "@id"
        },
        "hasInputRole": {
            "@id": "top:hasInputRole",
            "@type": "@id"
        },
        "hasExpectedType": {
            "@id": "top:hasExpectedType",
            "@type": "@id"
        }
    },
    "@graph": [
        {
            "@id": "ops:SpatialDownscaling",
            "@type": "top:Operation",
            "comment": "Derive local- to regional-scale (10 to 100 km) information from larger-scale models or data analyses.",
            "label": "Spatial downscaling",
            "isRealizedByMethod": [
                {
                    "@id": "ops:SpatialDownscaling/methods/StatisticalDownscaling",
                    "@type": "top:Method",
                    "label": "Statistical downscaling"
                },
                {
                    "@id": "ops:SpatialDownscaling/methods/DynamicalDownscaling",
                    "@type": "top:Method",
                    "label": "Dynamical downscaling using climate models"
                },
                {
                    "@id": "ops:SpatialDownscaling/methods/AIMethods",
                    "@type": "top:Method",
                    "label": "AI methods (experimental)"
                },
                {
                    "@id": "ops:SpatialDownscaling/methods/HybridDownscaling",
                    "@type": "top:Method",
                    "label": "Hybrid downscaling"
                }
            ]
        },
        {
            "@id": "ops:Regridding",
            "@type": "top:Operation",
            "comment": "Interpolation from one grid resolution to a different grid resolution.",
            "label": "Regridding",
            "isRealizedByMethod": [
                {
                    "@id": "ops:SpatialDownscaling/methods/BilinearRegridding",
                    "@type": "top:Method",
                    "label": "Bilinear regridding"
                },
                {
                    "@id": "ops:SpatialDownscaling/methods/NearestNeighbour",
                    "@type": "top:Method",
                    "label": "Nearest neighbour"
                }
            ]
        },
        {
            "@id": "ops:ComputationOfMetrics",
            "@type": "top:Operation",
            "comment": "",
            "label": "Computation of metrics",
            "hasInputRole": {
                "@id": "ops:ComputationOfMetrics/roles/metric",
                "label": "metric",
                "hasExpectedType": "data:DepedentVariable"
            }
        },
        {
            "@id": "ops:BiasCorrection",
            "@type": "top:Operation",
            "comment": "Bias correction/adjustment/calibration using statistical techniques",
            "label": "Bias correction",
            "isRealizedByMethod": [
                {
                    "@id": "ops:SpatialDownscaling/methods/DeltaMethod",
                    "@type": "top:Method",
                    "label": "Delta method"
                },
                {
                    "@id": "ops:SpatialDownscaling/methods/QuantileMapping",
                    "@type": "top:Method",
                    "label": "Quantile mapping"
                },
                {
                    "@id": "ops:SpatialDownscaling/methods/LinearScaling",
                    "@type": "top:Method",
                    "label": "Linear scaling"
                },
                {
                    "@id": "ops:SpatialDownscaling/methods/QuantileDeltaMapping",
                    "@type": "top:Method",
                    "label": "Quantile delta mapping"
                },
                {
                    "@id": "ops:SpatialDownscaling/methods/ScaleDistributionMapping",
                    "@type": "top:Method",
                    "label": "Scale distribution mapping"
                },
                {
                    "@id": "ops:SpatialDownscaling/methods/CDFt",
                    "@type": "top:Method",
                    "label": "CDFt"
                },
                {
                    "@id": "ops:SpatialDownscaling/methods/EquidistantCDFMatching",
                    "@type": "top:Method",
                    "label": "Equidistant CDF matching"
                },
                {
                    "@id": "ops:SpatialDownscaling/methods/ISIMIP3BASD",
                    "@type": "top:Method",
                    "label": "ISIMIP3BASD"
                }
            ]
        },
        {
            "@id": "ops:BiasQuantification",
            "@type": "top:Operation",
            "comment": "Bias indicates a systematic difference, and bias relative to reliable observations is interpreted as “error”. The baseline values can come from observations or a benchmark model simulation, or ensemble mean.",
            "label": "Bias quantification"
        },
        {
            "@id": "ops:Clustering",
            "@type": "top:Operation",
            "comment": "Clustering operation.",
            "label": "Clustering"
        },
        {
            "@id": "ops:EnsembleDescriptiveStatistic",
            "@type": "top:Operation",
            "label": "Ensemble descriptive stastic.",
            "comment": "A summary statistic that quantitatively describes or summarizes features from an ensemble of climate projections.",
            "isSpecializedBy": [
                {
                    "@id": "ops:Mean",
                    "@type": "top:Operation",
                    "label": "Mean"
                },
                {
                    "@id": "ops:Median",
                    "@type": "top:Operation",
                    "label": "Median"
                },
                {
                    "@id": "ops:StandardDeviation",
                    "@type": "top:Operation",
                    "label": "Standard deviation"
                },
                {
                    "@id": "ops:EnsembleRange",
                    "@type": "top:Operation",
                    "label": "Ensemble range"
                }
            ]
        },
        {
            "@id": "ops:PatternMatching",
            "@type": "top:Operation",
            "label": "Pattern matching",
            "isRealizedByPlan": [
                {
                    "@id": "ops:PatternMatching/plans/WithClustering",
                    "@type": "top:Plan",
                    "label": "Pattern matching plan including a clustering step.",
                    "tasks": {
                        "@id": "ops:PatternMatching/plans/WithClustering/tasks/Clustering",
                        "@type": "top:Plan",
                        "label": "Clustering step of a pattern matching plan",
                        "executedThroughOperation": "ops:Clustering"
                    }
                }
            ]
        },
        {
            "@id": "ops:ClimateProjectionEvaluation",
            "@type": "top:Operation",
            "comment": "Evaluation of the considered climate projections, according to reliability and relevance to the case.",
            "label": "Climate projection evaluation",
            "isRealizedByPlan": {
                "@id": "ops:ClimateProjectionEvaluation/plans/generic",
                "@type": "top:Plan",
                "label": "Generic plan for the evaluation of climate projections, possbily including bias quantification or pattern matching.",
                "tasks": [
                    {
                        "@id": "ops:ClimateProjectionEvaluation/plans/generic/tasks/BiasQuantification",
                        "@type": "top:Task",
                        "comment": "Bias indicates a systematic difference, and bias relative to reliable observations is interpreted as “error”. The baseline values can come from observations or a benchmark model simulation, or ensemble mean.",
                        "label": "Bias quantification",
                        "executedThroughOperation": "ops:BiasQuantification"
                    },
                    {
                        "@id": "ops:ClimateProjectionEvaluation/plans/generic/tasks/PatternMatching",
                        "@type": "top:Task",
                        "label": "Pattern matching",
                        "executedThroughOperation": "ops:PatternMatching"
                    }
                ]
            }
        },
        {
            "@id": "ops:ClimateProjectionSelection",
            "@type": "top:Operation",
            "comment": "Selection of the the climate projections to be considered in the analysis, according to results of the evaluation.",
            "label": "Climate projection selection"
        },
        {
            "@id": "ops:FilterClimateProjections",
            "@type": "top:Operation",
            "comment": "Filter available climate projections, according to some criteria.",
            "label": "Filter climate projections",
            "isSpecializedBy": [
                {
                    "@id": "ops:FilterClimateProjectionsByVariable",
                    "@type": "top:Operation",
                    "comment": "Filter available climate projections, according to exposed variables or metrics.",
                    "label": "Filter climate projections by variable",
                    "hasInputRole": {
                        "@id": "ops:FilterClimateProjectionsByVariable/roles/SelectedVariable",
                        "label": "Selected variable",
                        "hasExpectedType": "data:DepedentVariable"
                    }
                },
                {
                    "@id": "ops:FilterClimateProjectionsByBaselinePeriod",
                    "@type": "top:Operation",
                    "comment": "Filter available climate projections, according to the baseline period.",
                    "label": "Filter climate projections by baseline period",
                    "hasInputRole": {
                        "@id": "ops:FilterClimateProjectionsByBaselineInterval/roles/SelectedBaselineInterval",
                        "label": "Selected baseline interval",
                        "hasExpectedType": "data:TemporalRegion"
                    }
                },
                {
                    "@id": "ops:FilterClimateProjectionsByFuturePeriod",
                    "@type": "top:Operation",
                    "comment": "Filter available climate projections, according to the future period.",
                    "label": "Filter climate projections by future period",
                    "hasInputRole": {
                        "@id": "ops:FilterClimateProjectionsByFuturePeriod/roles/SelectedFuturePeriod",
                        "label": "Selected future period",
                        "hasExpectedType": "data:TemporalRegion"
                    }
                },
                {
                    "@id": "ops:FilterClimateProjectionsByEmissionScenario",
                    "@type": "top:Operation",
                    "comment": "Filter available climate projections, according to the emission scenarios.",
                    "label": "Filter climate projections by emission scenario",
                    "hasInputRole": {
                        "@id": "ops:FilterClimateProjectionsByEmissionScenario/roles/SelectedEmissionScenario",
                        "label": "Selected emission scenario",
                        "hasExpectedType": "ccso:EmissionScenario"
                    }
                },
                {
                    "@id": "ops:FilterClimateProjectionsByGlobalWarmingLevel",
                    "@type": "top:Operation",
                    "comment": "Filter available climate projections, according to the global warming level as target, rather than (or in addition to) doing it on a specific future period and emission scenario.",
                    "label": "Filter climate projections by global warming level",
                    "hasInputRole": {
                        "@id": "ops:FilterClimateProjectionsByGlobalWarmingLevel/roles/SelectedGlobalWarmingLevel",
                        "label": "Selected global warming level"
                    }
                }
            ]
        },
        {
            "@id": "ops:ClimateProjectionSelection",
            "@type": "top:Operation",
            "comment": "The selection of some climate projections according to relevance to a specific case.",
            "label": "Climate projection selection",
            "isRealizedByPlan": [
                {
                    "@context": {
                        "@base": "plans/ClimateProjectionSelectionPlan/"
                    },
                    "@id": "../ClimateProjectionSelectionPlan",
                    "@type": "top:Plan",
                    "comment": "A typical plan for the selection of climate projections relevant to a specific context.",
                    "label": "Climate projection selection plan",
                    "tasks": [
                        {
                            "@id": "tasks/FilterByVariable",
                            "@type": "top:Task",
                            "comment": "The task of filtering available climate projections, according to exposed variables or metrics.",
                            "label": "Filter by variable",
                            "directlyPrecedes": "tasks/FilterByBaselinePeriod",
                            "executedThroughOperation": "ops:FilterClimateProjectionsByVariable",
                            "sendsDefaultOutputToPlanRole": "object-roles/SelectedProjection"
                        },
                        {
                            "@id": "tasks/FilterByBaselinePeriod",
                            "@type": "top:Task",
                            "comment": "The task of filtering available climate projections, according to the baseline period.",
                            "label": "Filter by baseline period",
                            "directlyPrecedes": [
                                "tasks/FilterByFuturePeriod",
                                "tasks/FilterByGlobalWarmingLevel"
                            ],
                            "executedThroughOperation": "ops:FilterClimateProjectionsByBaselinePeriod",
                            "sendsDefaultOutputToPlanRole": "object-roles/SelectedProjection"
                        },
                        {
                            "@id": "tasks/FilterByFuturePeriod",
                            "@type": "top:Task",
                            "comment": "The task of filtering available climate projections, according to the future period.",
                            "label": "Filter by future period",
                            "directlyPrecedes": "tasks/FilterByEmissionScenario",
                            "executedThroughOperation": "ops:FilterClimateProjectionsByFuturePeriod",
                            "sendsDefaultOutputToPlanRole": "object-roles/SelectedProjection"
                        },
                        {
                            "@id": "tasks/FilterByEmissionScenario",
                            "@type": "top:Task",
                            "comment": "The task of filtering available climate projections, according to the emission scenario.",
                            "label": "Filter by emission scenario",
                            "directlyPrecedes": "tasks/FilterByAdditionalCriteria",
                            "executedThroughOperation": "ops:FilterClimateProjectionsByEmissionScenario",
                            "sendsDefaultOutputToPlanRole": "object-roles/SelectedProjection"
                        },
                        {
                            "@id": "tasks/FilterByGlobalWarmingLevel",
                            "@type": "top:Task",
                            "comment": "The task of filtering available climate projections, according to the global warming level as target, rather than (or in addition to) doing it on a specific future period and emission scenario.",
                            "label": "Filter by global warming level",
                            "directlyPrecedes": "tasks/FilterByAdditionalCriteria",
                            "executedThroughOperation": "ops:FilterClimateProjectionsByGlobalWarmingLevel",
                            "sendsDefaultOutputToPlanRole": "object-roles/SelectedProjection"
                        },
                        {
                            "@id": "tasks/FilterByAdditionalCriteria",
                            "@type": "top:Task",
                            "comment": "The task of filtering the avalaible data by some criteria that is not by variable/metric, baseline period, future period, nor global warmin level.",
                            "label": "Filter by additional criteria",
                            "executedThroughOperation": "ops:FilterClimateProjections",
                            "sendsDefaultOutputToPlanRole": "object-roles/SelectedProjection"
                        }
                    ]
                }
            ]
        },
        {
            "@id": "ops:TimeSeriesAnalysis",
            "@type": "top:Operation",
            "label": "Time series analysis",
            "isSpecializedBy": [
                {
                    "@id": "ops:DifferenceQuantification",
                    "@type": "top:Operation",
                    "label": "Difference quantification"
                },
                {
                    "@id": "ops:TrendAnalysis",
                    "@type": "top:Operation",
                    "label": "Trend analysis"
                }
            ]
        },
        {
            "@id": "ops:ModelWeighting",
            "@type": "top:Operation",
            "label": "Model weighting"
        },
        {
            "@id": "ops:ExtremeValueAnalysis",
            "@type": "top:Operation",
            "label": "Extreme value analysis",
            "isRealizedByMethod": [
                {
                    "@id": "ops:ExtremeValueAnalysis/methods/ReturnPeriodAnalysis",
                    "@type": "top:Method",
                    "label": "Return period analysis"
                },
                {
                    "@id": "ops:ExtremeValueAnalysis/methods/ThresholdAnalysis",
                    "@type": "top:Method",
                    "label": "Threshold analysis"
                },
                {
                    "@id": "ops:ExtremeValueAnalysis/methods/FrequencyAnalysis",
                    "@type": "top:Method",
                    "label": "Frequency analysis"
                },
                {
                    "@id": "ops:ExtremeValueAnalysis/methods/ExtremeValueDistribution",
                    "@type": "top:Method",
                    "label": "Extreme value distribution"
                }
            ]
        },
        {
            "@id": "ops:SignificanceTesting",
            "@type": "top:Operation",
            "label": "Significance testing"
        },
        {
            "@id": "ops:ClimateChangeQuantification",
            "@type": "top:Operation",
            "comment": "Quantify the magnitude of climate change in respect to a baseline.",
            "label": "Climate change quantification",
            "isRealizedByPlan": {
                "@id": "ops:ClimateChangeQuantification/plans/generic",
                "@type": "top:Plan",
                "label": "Generic plan for climate change quantification",
                "comment": "Generic plan for the quantification of climate change considering an ensemble of projections.",
                "tasks": [
                    {
                        "@id": "ops:ClimateChangeQuantification/plans/generic/tasks/ModelWeighting",
                        "@type": "top:Task",
                        "label": "Model weighting",
                        "executedThroughOperation": "ops:ModelWeighting"
                    },
                    {
                        "@id": "ops:ClimateChangeQuantification/plans/generic/tasks/DifferenceQuantification",
                        "@type": "top:Task",
                        "label": "Difference quantification",
                        "executedThroughOperation": "ops:DifferenceQuantification"
                    },
                    {
                        "@id": "ops:ClimateChangeQuantification/plans/generic/tasks/ExtremeValueAnalysis",
                        "@type": "top:Task",
                        "label": "Extreme value analysis",
                        "executedThroughOperation": "ops:ExtremeValueAnalysis"
                    },
                    {
                        "@id": "ops:ClimateChangeQuantification/plans/generic/tasks/TrendAnalysis",
                        "@type": "top:Task",
                        "label": "Trend analysis",
                        "executedThroughOperation": "ops:TrendAnalysis"
                    },
                    {
                        "@id": "ops:ClimateChangeQuantification/plans/generic/tasks/SignificanceTesting",
                        "@type": "top:Task",
                        "label": "Significance testing",
                        "executedThroughOperation": "ops:SignificanceTesting"
                    }
                ]
            }
        },
        {
            "@id": "ops:UncertaintyQuantification",
            "@type": "top:Operation",
            "label": "Uncertainty quantification",
            "isRealizedByMethod": [
                {
                    "@id": "ops:UncertaintyQuantification/methods/CDFAnalysis",
                    "@type": "top:Operation",
                    "label": "Analysis of cumulative distribution function (CDF)"
                },
                {
                    "@id": "ops:UncertaintyQuantification/methods/PDFAnalysis",
                    "@type": "top:Operation",
                    "label": "Analysis of probability density function (PDF)"
                }
            ]
        },
        {
            "@id": "ops:ClimateInformationStudy",
            "@type": "top:Operation",
            "comment": "The operation describing the study of climate information relevant to a specific context.",
            "label": "Climate information study",
            "isRealizedByPlan": [
                {
                    "@context": {
                        "@base": "plans/ClimateInformationStudyPlan/"
                    },
                    "@id": "../ClimateInformationStudyPlan",
                    "@type": "top:Plan",
                    "comment": "A typical plan for the study of climate information relevant to a specific context, organized in two phases: climate information preparation and climate information analysis.",
                    "label": "Climate information study plan",
                    "tasks": [
                        {
                            "@context": {
                                "@base": "tasks/ClimateInformationPreparation/"
                            },
                            "@id": "../ClimateInformationPreparation",
                            "@type": "top:Task",
                            "comment": "The task of preparing the climate information.",
                            "label": "Climate information preparation",
                            "directlyPrecedes": "tasks/ClimateInformationAnalysis",
                            "hasPart": [
                                {
                                    "@id": "subtasks/BaseClimateProjectionSelection",
                                    "@type": "top:Task",
                                    "comment": "The task of selecting the avalaible climate projections that will be used in the analysis.",
                                    "label": "Data selection",
                                    "sendsDefaultOutputToPlanRole": "../../object-roles/SelectedProjection",
                                    "directlyPrecedes": "subtasks/SpatialDownscaling",
                                    "executedThroughOperation": "ops:ClimateProjectionSelection"
                                },
                                {
                                    "@id": "subtasks/SpatialDownscaling",
                                    "@type": "top:Task",
                                    "comment": "The task of applying spatial downscaling methods if needed: according to the resolution available in the projections and the required resolution.",
                                    "label": "Spatial downscaling",
                                    "directlyPrecedes": "subtasks/Regridding",
                                    "executedThroughOperation": "ops:SpatialDownscaling"
                                },
                                {
                                    "@id": "subtasks/Regridding",
                                    "@type": "top:Task",
                                    "comment": "The task of applying regridding methods if needed: according to the grid(s) available in the projections and the desired grid.",
                                    "label": "Regridding",
                                    "directlyPrecedes": "subtasks/ComputationOfMetrics",
                                    "executedThroughOperation": "ops:Regridding"
                                },
                                {
                                    "@id": "subtasks/ComputationOfMetrics",
                                    "@type": "top:Task",
                                    "comment": "The task of computing relevant metrics from the values of the climate variables in the projections, possibly including bias correction using observational data.",
                                    "label": "Computation of metrics",
                                    "directlyPrecedes": "subtasks/BiasCorrection",
                                    "executedThroughOperation": "ops:ComputationOfMetrics"
                                },
                                {
                                    "@id": "subtasks/BiasCorrection",
                                    "@type": "top:Task",
                                    "comment": "The task of applying bias correction methods to the obtained metrics, based on observational data.",
                                    "label": "Bias correction",
                                    "directlyPrecedes": "subtasks/ClimateSimulationEvaluation",
                                    "executedThroughOperation": "ops:BiasCorrection"
                                },
                                {
                                    "@id": "subtasks/ClimateProjectionEvaluation",
                                    "@type": "top:Task",
                                    "comment": "The task of evaluating the considered climate projections, according to reliability and relevance to the case.",
                                    "label": "Climate projection evaluation",
                                    "directlyPrecedes": "subtasks/ClimateProjectionSelection",
                                    "executedThroughOperation": "ops:ClimateProjectionEvaluation"
                                },
                                {
                                    "@id": "subtasks/ClimateProjectionSelection",
                                    "@type": "top:Task",
                                    "comment": "The task of selecting the climate projections to be considered in the analysis, according to results of the evaluation.",
                                    "label": "Climate projection selection",
                                    "sendsDefaultOutputToPlanRole": "../../object-roles/SelectedClimateSimulation",
                                    "executedThroughOperation": "ops:ClimateProjectionSelection"
                                }
                            ]
                        },
                        {
                            "@context": {
                                "@base": "tasks/ClimateInformationAnalysis/"
                            },
                            "@id": "../ClimateInformationAnalysis",
                            "@type": "top:Task",
                            "comment": "The task of analysing the avalaible climate information.",
                            "label": "Climate information analysis",
                            "hasPart": [
                                {
                                    "@id": "subtasks/ClimateChangeQuantification",
                                    "@type": "top:Task",
                                    "comment": "The task of applying the climate change quantification method.",
                                    "label": "Climate change quantification",
                                    "directlyPrecedes": "subtasks/UncertaintyQuantification",
                                    "executedThroughOperation": "ops:ClimateChangeQuantification"
                                },
                                {
                                    "@id": "subtasks/UncertaintyQuantification",
                                    "@type": "top:Task",
                                    "comment": "The task of applying uncertainty quantification",
                                    "label": "Uncertainty quantification",
                                    "executedThroughOperation": "ops:UncertaintyQuantification"
                                }
                            ]
                        }
                    ],
                    "roles": [
                        {
                            "@id": "object-roles/SelectedBaseProjection",
                            "@type": "top:WorkflowRole",
                            "label": "Selected base projection",
                            "comment": "An already available projection selected for a case in the context of a climate service workflow execution.",
                            "range": "data:Dataset"
                        },
                        {
                            "@id": "object-roles/SelectedProjection",
                            "@type": "top:WorkflowRole",
                            "label": "Selected projection",
                            "comment": "A projection selected for analysis in the context of a climate service workflow execution, after adaptation and comparison of relevant available projections.",
                            "range": "data:Dataset"
                        }
                    ]
                },
                {
                    "@context": {
                        "@base": "plans/CollectiveClimateInformationStudyPlan/"
                    },
                    "@id": "../CollectiveClimateInformationStudyPlan",
                    "@type": "top:Plan",
                    "comment": "A plan for the collaborative study of climate information in order to address a specific need. It involves the collection of multiple climate information study plan, their consolidation in one plan, and the execution of such a plan.",
                    "label": "Collective climate information study plan",
                    "tasks": [
                        {
                            "@id": "tasks/ClimateInformationStudyContribution",
                            "@type": "top:Task",
                            "comment": "The task of designing a contribution to the case consisting of a plan for climate information study.",
                            "label": "Contribution for climate information study",
                            "directlyPrecedes": "tasks/ClimateInformationStudyConsolidation",
                            "isTaskOf": "agent-roles/CaseContributor",
                            "sendsDefaultOutputToPlanRole": "object-roles/ProposedClimateInformationStudyPlan"
                        },
                        {
                            "@id": "tasks/ClimateInformationStudyConsolidation",
                            "@type": "top:Task",
                            "comment": "The task of evaluating the proposed plans for climate information study and the development of a single plan based on the proposals.",
                            "label": "Climate information study consolidation",
                            "directlyPrecedes": "tasks/ClimateInformationStudyExecution",
                            "isTaskOf": "agent-roles/CaseSolver",
                            "getsDefaultInputFromPlanRole": "object-roles/ProposedClimateInformationStudyPlan",
                            "sendsDefaultOutputToPlanRole": "object-roles/ConsolidatedClimateInformationStudyPlan"
                        },
                        {
                            "@id": "tasks/ClimateInformationStudyExecution",
                            "@type": "top:Task",
                            "comment": "The task of executing the consolidated plan for climate information study.",
                            "label": "Climate information study execution",
                            "isTaskOf": "agent-roles/CaseSolver",
                            "getsDefaultInputFromPlanRole": "object-roles/ConsolidatedClimateInformationStudyPlan"
                        }
                    ],
                    "roles": [
                        {
                            "@id": "object-roles/ProposedClimateInformationStudyPlan",
                            "@type": "top:WorkflowRole",
                            "label": "Proposed climate information study plan",
                            "comment": "A proposal for climate information study, structured as a plan. The analysis of the context is considered a prerequisite, so outside of such proposal. The impact analysis is also not considered, as it is meant to be carried on after climate information study.",
                            "range": null
                        },
                        {
                            "@id": "object-roles/ConsolidatedClimateInformationStudyPlan",
                            "@type": "top:WorkflowRole",
                            "label": "Consolidated climate information study plan",
                            "comment": "A plan for climate information study, composed considering a set of proposed plans contributed by different experts.",
                            "range": null
                        }
                    ]
                }
            ]
        },
        {
            "@id": "ops:ClimateServiceCaseResolution",
            "@type": "top:Operation",
            "comment": "The operation describing, at an abstract level, the handling of a request for climate information.",
            "label": "Climate service case resolution",
            "isRealizedByPlan": {
                "@context": {
                    "@base": "plans/ClimateProcessWorkflow/"
                },
                "@id": "../ClimateProcessWorkflow",
                "@type": "top:Workflow",
                "comment": "A workflow describing the typical handling of a request for climate information.",
                "label": "Climate service case resolution workflow",
                "tasks": [
                    {
                        "@id": "tasks/ClimateInformationRequest",
                        "@type": "top:Task",
                        "comment": "The task of requesting the climate information.",
                        "label": "Climate information request",
                        "directlyPrecedes": "tasks/UserBackgroundInformationRequest",
                        "isTaskOf": "agent-roles/InformationRequester"
                    },
                    {
                        "@id": "tasks/UserBackgroundInformationRequest",
                        "@type": "top:Task",
                        "comment": "The task of requesting user background information.",
                        "label": "User background information request",
                        "directlyPrecedes": "tasks/ProvideOrganizationInformation",
                        "isTaskOf": "agent-roles/CaseCreator"
                    },
                    {
                        "@context": {
                            "@base": "tasks/ProvideOrganizationInformation/"
                        },
                        "@id": "../ProvideOrganizationInformation",
                        "@type": "top:Task",
                        "comment": "The task of providing information on the organization requesting the service.",
                        "label": "Provide organization information",
                        "directlyPrecedes": "tasks/ProvideClimateCaseInformation",
                        "isTaskOf": "agent-roles/InformationRequester",
                        "hasPart": [
                            {
                                "@id": "subtasks/OrganisationInformationDescription",
                                "@type": "top:Task",
                                "comment": "The task of describing organisation information.",
                                "label": "Organisation information description",
                                "isTaskOf": "../../agent-roles/InformationRequester"
                            },
                            {
                                "@id": "subtasks/CustomerNeedDefinition",
                                "@type": "top:Task",
                                "comment": "The task of defining the customer needs (identifying climate-related challenges faced by the organisation.)",
                                "label": "Customer need definition",
                                "isTaskOf": "../../agent-roles/InformationRequester",
                                "sendsDefaultOutputToPlanRole": "../../object-roles/CustomerNeed"
                            }
                        ]
                    },
                    {
                        "@context": {
                            "@base": "tasks/ProvideClimateCaseInformation/"
                        },
                        "@id": "../ProvideClimateCaseInformation",
                        "@type": "top:Task",
                        "comment": "The task of providing information on the organization requesting the service.",
                        "label": "Provide organization information",
                        "directlyPrecedes": "tasks/ProvideDecisionContextInformation",
                        "isTaskOf": "agent-roles/InformationRequester",
                        "hasPart": [
                            {
                                "@id": "subtasks/ClimateInformationRequestGoalDefinition",
                                "@type": "top:Task",
                                "comment": "The task of defining the goal of the climate information request.",
                                "label": "Climate information request goal definition",
                                "isTaskOf": "../../agent-roles/InformationRequester",
                                "sendsDefaultOutputToPlanRole": "../../object-roles/Goal"
                            },
                            {
                                "@id": "subtasks/CustomerNeedDefinition",
                                "@type": "top:Task",
                                "comment": "The task of defining the customer needs (identifying climate-related challenges faced by the organisation.)",
                                "label": "Customer need definition",
                                "isTaskOf": "../../agent-roles/InformationRequester",
                                "sendsDefaultOutputToPlanRole": "../../object-roles/CustomerNeed"
                            },
                            {
                                "@id": "subtasks/OrganisationInformationDescription",
                                "@type": "top:Task",
                                "comment": "The task of describing organisation information.",
                                "label": "Organisation information description",
                                "isTaskOf": "../../agent-roles/InformationRequester"
                            }
                        ]
                    },
                    {
                        "@context": {
                            "@base": "tasks/ProvideDecisionContextInformation/"
                        },
                        "@id": "../ProvideDecisionContextInformation",
                        "@type": "top:Task",
                        "comment": "The task of providing decision context information.",
                        "label": "Provide decision context information",
                        "directlyPrecedes": "tasks/UserInformationExtraction",
                        "isTaskOf": "agent-roles/InformationRequester",
                        "hasPart": [
                            {
                                "@id": "subtasks/ClimateHazardImpactDescription",
                                "@type": "top:Task",
                                "comment": "The task of describing how climate hazards impact the organisation's activities.",
                                "label": "Climate hazard impact description",
                                "isTaskOf": "../../agent-roles/InformationRequester"
                            },
                            {
                                "@id": "subtasks/ClimateQuestionDescription",
                                "@type": "top:Task",
                                "comment": "The task of describing climate questions.",
                                "label": "Climate question description",
                                "isTaskOf": "../../agent-roles/InformationRequester",
                                "getsDefaultInputFromPlanRole": "../../object-roles/RelevantHazardType",
                                "sendsDefaultOutputToPlanRole": "../../object-roles/RelevantClimateQuestion"
                            },
                            {
                                "@id": "subtasks/ClimateRiskFramingSpecification",
                                "@type": "top:Task",
                                "comment": "The task of specifying the climate risk framing.",
                                "label": "Climate risk framing specification",
                                "isTaskOf": "../../agent-roles/InformationRequester"
                            },
                            {
                                "@id": "subtasks/DecisionContextSpecification",
                                "@type": "top:Task",
                                "label": "Decision context specification",
                                "comment": "The task of listing decisions or actions that would benefit from better climate information.",
                                "isTaskOf": [
                                    "../../agent-roles/CaseCreator",
                                    "../../agent-roles/InformationRequester"
                                ]
                            },
                            {
                                "@id": "subtasks/HazardIdentification",
                                "@type": "top:Task",
                                "comment": "The task of identifying hazards.",
                                "label": "Hazard identification",
                                "isTaskOf": [
                                    "../../agent-roles/CaseSolver",
                                    "../../agent-roles/InformationRequester"
                                ],
                                "sendsDefaultOutputToPlanRole": "../../object-roles/RelevantHazardType"
                            },
                            {
                                "@id": "subtasks/InformationOnExposureIdentification",
                                "@type": "top:Task",
                                "comment": "The task of identifying information on exposure.",
                                "label": "Information on exposure identification",
                                "isTaskOf": [
                                    "../../agent-roles/CaseCreator",
                                    "../../agent-roles/InformationRequester"
                                ]
                            },
                            {
                                "@id": "subtasks/ObservationAnalysis",
                                "@type": "top:Task",
                                "label": "Observation analysis",
                                "isTaskOf": [
                                    "../../agent-roles/CaseCreator",
                                    "../../agent-roles/InformationRequester"
                                ]
                            },
                            {
                                "@id": "subtasks/PlanningTimeScalesDefinition",
                                "@type": "top:Task",
                                "comment": "The task of defining planning time scales.",
                                "label": "Planning time scales definition",
                                "isTaskOf": [
                                    "../../agent-roles/CaseCreator",
                                    "../../agent-roles/InformationRequester"
                                ],
                                "toBeAssociatedWithARole": true
                            },
                            {
                                "@id": "subtasks/RiskToleranceRating",
                                "@type": "top:Task",
                                "comment": "The task of rating the risk tolerance.",
                                "label": "Risk tolerance rating",
                                "isTaskOf": "../../agent-roles/InformationRequester",
                                "sendsDefaultOutputToPlanRole": "../../object-roles/RiskToleranceRatingOutput"
                            },
                            {
                                "@id": "subtasks/SpatialRegionIndication",
                                "@type": "top:Task",
                                "comment": "The task of indicating the spatial region of interest.",
                                "label": "Spatial region indication",
                                "isTaskOf": [
                                    "../../agent-roles/CaseCreator",
                                    "../../agent-roles/InformationRequester"
                                ],
                                "sendsDefaultOutputToPlanRole": "../../object-roles/SelectedGeodeticRegion"
                            }
                        ]
                    },
                    {
                        "@id": "tasks/UserInformationExtraction",
                        "@type": "top:Task",
                        "comment": "The task of extracting user information.",
                        "label": "User information request",
                        "directlyPrecedes": "tasks/CaseCreation",
                        "isTaskOf": "agent-roles/CaseCreator"
                    },
                    {
                        "@id": "tasks/CaseCreation",
                        "@type": "top:Task",
                        "comment": "The task of creating a case.",
                        "label": "Case creation",
                        "directlyPrecedes": [
                            "tasks/AdditionalInformationSearch",
                            "tasks/ClimateInformationPreparation"
                        ],
                        "isTaskOf": "agent-roles/CaseCreator"
                    },
                    {
                        "@context": {
                            "@base": "tasks/AdditionalInformationSearch/"
                        },
                        "@id": "../AdditionalInformationSearch",
                        "@type": "top:Task",
                        "comment": "The task of requesting external expertise such as an expert or literature review.",
                        "label": "Additional information search",
                        "directlyPrecedes": "tasks/ClimateInformationStudy",
                        "isTaskOf": "agent-roles/CaseSolver",
                        "hasPart": [
                            {
                                "@id": "subtasks/ExternalExpertiseSearch",
                                "@type": "top:Task",
                                "label": "External expertise search",
                                "isTaskOf": "agent-roles/CaseSolver"
                            },
                            {
                                "@id": "subtasks/PerformLiteratureReview",
                                "@type": "top:Task",
                                "label": "Perform literature review",
                                "isTaskOf": "agent-roles/CaseSolver"
                            }
                        ]
                    },
                    {
                        "@id": "tasks/ClimateInformationStudy",
                        "@type": "top:Task",
                        "comment": "The task of performing climate information study in order to address the case.",
                        "label": "Climate information study",
                        "directlyPrecedes": "tasks/SendClimateInformation",
                        "isTaskOf": "agent-roles/CaseSolver",
                        "executedThroughOperation": "ops:ClimateInformationStudy"
                    },
                    {
                        "@id": "tasks/SendClimateInformation",
                        "@type": "top:Task",
                        "comment": "The task of sending climate information.",
                        "label": "Send climate information",
                        "directlyPrecedes": "tasks/ClimateInformationCommunication",
                        "isTaskOf": "agent-roles/CaseSolver"
                    },
                    {
                        "@id": "tasks/ClimateInformationCommunication",
                        "@type": "top:Task",
                        "comment": "The task of communicating the climate information.",
                        "label": "Climate information communication",
                        "isTaskOf": "agent-roles/InformationRequester"
                    }
                ],
                "roles": [
                    {
                        "@id": "agent-roles/InformationRequester",
                        "@type": "top:WorkflowRole",
                        "label": "Information requester",
                        "comment": "The user that requests and uses the climate information.",
                        "range": "top:Agent"
                    },
                    {
                        "@id": "agent-roles/CaseCreator",
                        "@type": "top:WorkflowRole",
                        "label": "Creator",
                        "comment": "The creator of the climate case.",
                        "range": "top:Agent"
                    },
                    {
                        "@id": "agent-roles/CaseSolver",
                        "@type": "top:WorkflowRole",
                        "label": "Solver",
                        "comment": "The solver of the climate case.",
                        "range": "top:Agent"
                    },
                    {
                        "@id": "object-roles/RelevantClimateQuestion",
                        "@type": "top:WorkflowRole",
                        "label": "Relevant climate question",
                        "comment": "A climate question deemed relevant for the solution of a case in the context of a climate service workflow execution.",
                        "range": "top:Description"
                    },
                    {
                        "@id": "object-roles/CustomerNeed",
                        "@type": "top:WorkflowRole",
                        "label": "Customer need",
                        "comment": "A description of the customer needs, in respect to the request.",
                        "range": "top:Description"
                    },
                    {
                        "@id": "object-roles/Goal",
                        "@type": "top:WorkflowRole",
                        "label": "Goal",
                        "comment": "Concrete information goal that should be achieved in order to solve the case.",
                        "range": "top:Goal"
                    },
                    {
                        "@id": "object-roles/RelevantHazardType",
                        "@type": "top:WorkflowRole",
                        "label": "Relevant hazard type",
                        "comment": "An hazard type deemed relevant for a case in the context of a climate service workflow execution.",
                        "range": "ccso:HazardType"
                    },
                    {
                        "@id": "object-roles/RelevantClimateQuestion",
                        "@type": "top:WorkflowRole",
                        "label": "Relevant climate question",
                        "comment": "A climate question deemed relevant for the solution of a case in the context of a climate service workflow execution.",
                        "range": "top:Description"
                    },
                    {
                        "@id": "object-roles/SelectedGeodeticRegion",
                        "@type": "top:WorkflowRole",
                        "label": "Selected geodetic region",
                        "comment": "A geodetic region selected for a case in the context of a climate service workflow execution.",
                        "range": "data:GeodeticRegion"
                    }
                ]
            }
        }
    ]
}