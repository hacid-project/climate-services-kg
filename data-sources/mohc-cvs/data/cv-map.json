{
    "Organization type": {
        "scheme": {
            "id": "OrganizationType"
        }
    },
    "Organization size": {
        "scheme": {
            "id": "OrganizationSize",
            "members": [
                "small",
                "medium",
                "large"
            ]
        }
    },
    "Sector": {
        "scheme": "https://w3id.org/hacid/data/cs/climdex/sectors"
    },
    "Hazard": {
        "class": "ccso:HazardType"
    },
    "Risk rating": {
        "scheme": {
            "id": "RiskRating",
            "members": [
                "low",
                "medium",
                "high"
            ]
        }
    },
    "Index; variable": {
        "union": [
            {
                "collection": "https://w3id.org/hacid/data/cs/variables"
            },
            {
                "collection": "https://w3id.org/hacid/data/cs/indices"
            }
        ]
    },
    "Global warming level": {
        "scheme": {
            "id": "GlobalWarmingLevel",
            "range" : {
                "min": 1.5,
                "max": 6.0,
                "step": 0.5
            },
            "labelTemplate": "GWL\\(.)"
        }
    },
    "Method": {
        "class": "top:Method"
    },
    "Emission scenario": {
        "class": "ccso:EmissionScenario"
    },
    "Observation type": {
        "scheme": {
            "id": "ObservationType",
            "members": [
                "station-based",
                "gridded"
            ]
        }
    },
    "Access point": {
        "scheme": {
            "id": "AccessPoint"
        }
    },
    "Climate simulations":  {
        "class": "ccso:ClimateSimulation"
    },
    "Observation datasets": null,
    "Confidence level": {
        "scheme": {
            "id": "ConfidenceLevel",
            "members": [
                "low",
                "medium",
                "high"
            ]
        }
    }
}