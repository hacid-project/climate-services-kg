              "Input": "GWL; Climate simulations; Observations",
              "Output": "Pattern-scaled climate data",
              "Comment": "Requires simulation (and observation, if used) retrieval",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Conditional",
                "Condition": "Obligatory if \"Global warming level extraction method\" is \"Pattern scaling\"",
                "BackwardDependencies": [
                  "Conduct manual selection of climate simulations",
                  "Filter climate simulations by selection criteria",
                  "Choose global warming level",
                  "Choose global warming level extraction method"
                ]
              },
