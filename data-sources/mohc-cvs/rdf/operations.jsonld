              "Input": "Output metric, uncertainty estimate",
              "Output": "Aggregated climate information",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Optional",
                "BackwardDependencies": [
                  "Quantify future climate change",
                  "Quantify uncertainty"
                ]
              },
              "Description": "The operation that postprocesses (e.g., spatially aggregating) provided climate information",
