                ],
                "InformationType": "Optional",
                "Condition": "Obligatory if case solver decides not to manually select the climate simulations or use impact models instead",
                "BackwardDependencies": [
                  "Identify indices and variables",
                  "Choose future period",
                  "Define emission scenarios",
                  "Define relevant spatial resolutions",
                  "Define relevant temporal resolutions",
                  "Provide additional climate simulation selection criteria"
