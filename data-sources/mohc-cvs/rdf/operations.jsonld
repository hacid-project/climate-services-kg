                  "ExpectedType": {
                    "@type": "owl:Class",
                    "unionOf": [
                      {
                        "@id": "ccso:EmissionScenario",
                        "@type": "owl:Class"
                      },
                      {
                        "@type": "owl:Class",
                        "intersectionOf": [
                          "top:Interval",
                          {
                            "@type": "owl:Restriction",
                            "onProperty": "top:hasBoundaryValue",
                            "owl:allValuesFrom": {
                              "@id": "ccso:EmissionScenario",
                              "@type": "owl:Class"
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Output": "Selected spatial resolution range",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Obligatory"
              },
              "Description": "The operation that selects the required spatial resolution (e.g., 1 km, 60 km, 0.25°) range for the output climate data.",
              "@type": "top:Operation",
              "Label": "Define relevant spatial resolutions",
              "@id": "ops:DefineRelevantSpatialResolutions",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:DefineRelevantSpatialResolutions/associated-data",
                  "ExpectedType": {
                    "@type": "owl:Class",
                    "unionOf": [
                      {
                        "@id": "xsd:decimal",
                        "@type": "rdfs:Datatype"
                      },
                      {
                        "intersectionOf": [
                          {
                            "@type": "owl:Restriction",
                            "onProperty": "owl:onDatatype",
                            "owl:allValuesFrom": {
                              "@id": "xsd:decimal",
                              "@type": "rdfs:Datatype"
                            }
                          },
                          {
                            "@type": "owl:Restriction",
                            "onProperty": "owl:withRestrictions",
                            "owl:cardinality": 1
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Output": "Selected temporal resolution range",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Obligatory"
              },
              "Description": "The operation that selects the required temporal resolution (e.g., daily, monthly, annual, seasonal) range for the output climate data.",
              "@type": "top:Operation",
              "Label": "Define relevant temporal resolutions",
              "@id": "ops:DefineRelevantTemporalResolutions",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:DefineRelevantTemporalResolutions/associated-data",
                  "ExpectedType": {
                    "@type": "owl:Class",
                    "unionOf": [
                      {
                        "@id": "xsd:duration",
                        "@type": "rdfs:Datatype"
                      },
                      {
                        "intersectionOf": [
                          {
                            "@type": "owl:Restriction",
                            "onProperty": "owl:onDatatype",
                            "owl:allValuesFrom": {
                              "@id": "xsd:duration",
                              "@type": "rdfs:Datatype"
                            }
                          },
                          {
                            "@type": "owl:Restriction",
                            "onProperty": "owl:withRestrictions",
                            "owl:cardinality": 1
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Output": "Subseasonal slice",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Optional",
                "Condition": "For possible values, see Table 1 of this document: https://docs.google.com/document/d/1svoQ4lW1i4nFaPWZEzIxQakPmS_sDS4uO9yy9OmeSQo/edit?tab=t.0"
              },
              "Description": "The operation that selects a sub-annual period (e.g. month, season, period in year) of interest (e.g. boreal winter (DJFM), austral spring (SON), Januarys, Julys).",
              "@type": "top:Operation",
              "Label": "Define subannual selection",
              "@id": "ops:DefineSubannualSelection",
