{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "top": "https://w3id.org/hacid/onto/top-level/",
    "ccso": "https://w3id.org/hacid/onto/ccso/",
    "data": "https://w3id.org/hacid/onto/data/",
    "index": "https://w3id.org/hacid/data/cs/metoffice/indices/",
    "sector": "https://w3id.org/hacid/data/cs/climdex/sectors/",
    "parameter": "https://w3id.org/hacid/data/cs/climdex/parameters/",
    "variable": "https://w3id.org/hacid/data/cs/variables/mip/",
    "unit": "https://w3id.org/hacid/data/cs/unitsofmeasure/",
    "dimension": "https://w3id.org/hacid/data/cs/dimensions/",
    "aggregation": "https://w3id.org/hacid/data/cs/climdex/index-time-aggregations/",
    "temporalgrid": "https://w3id.org/hacid/data/cs/dimensions/time/reference-frames/gregorian/quantizations/",
    "Id": "@id",
    "Label": "rdfs:label",
    "Description": "rdfs:comment",
    "Specializations": "top:isSpecializedBy"
  },
  "@graph": [
    {
      "Specializations": [
        {
          "AssociatedEntities": "Text",
          "Range": "No",
          "InformationType": "Obligatory",
          "Role": [
            "InformationRequester",
            "CaseCreator"
          ],
          "Description": "The operation that provides background information such as information about the organisation and their climate information needs",
          "AssociatedData": {
            "type": "text"
          },
          "Specializations": [
            {
              "AssociatedEntities": "Text",
              "Range": "No",
              "InformationType": "Obligatory",
              "Role": [
                "InformationRequester"
              ],
              "Description": "The operation that provides the name of the customer organisation.",
              "AssociatedData": {
                "type": "text"
              },
              "Label": "Provide organization name",
              "Id": "ProvideOrganizationName"
            },
            {
              "AssociatedEntities": "Organisation Type",
              "Range": "No",
              "InformationType": "Obligatory",
              "Role": [
                "InformationRequester"
              ],
              "Description": "The operation that describes the type of the customer organisation.",
              "AssociatedData": {
                "type": "uri",
                "cv": "OrganisationType"
              },
              "Label": "Describe organization type",
              "Id": "DescribeOrganizationType"
            },
            {
              "AssociatedEntities": "Organization Size",
              "Range": "No",
              "InformationType": "Optional",
              "Role": [
                "InformationRequester"
              ],
              "Description": "The operation that describes the size (e.g. small, medium, large) of the customer organisation.",
              "AssociatedData": {
                "type": "uri",
                "cv": "OrganizationSize"
              },
              "Label": "Describe organization size",
              "Id": "DescribeOrganizationSize"
            },
            {
              "AssociatedEntities": "Sector",
              "Range": "No",
              "InformationType": "Optional",
              "Comment": "Can use sectors associated with hazards",
              "Role": [
                "InformationRequester"
              ],
              "Description": "The operation that describes the operating sector of the customer organisation.",
              "AssociatedData": {
                "type": "uri",
                "cv": "Sector"
              },
              "Label": "Describe organization operating sector",
              "Id": "DescribeOrganizationOperatingSector"
            },
            {
              "AssociatedEntities": "Number",
              "Range": "Yes",
              "InformationType": "Optional",
              "Comment": "Can be described in one of the text fields regarding the case",
              "Role": [
                "InformationRequester"
              ],
              "Description": "The operation that quantifies years of experience in using climate data",
              "AssociatedData": {
                "type": "range",
                "items": {
                  "type": "number"
                }
              },
              "Label": "Provide years of experience in using climate data",
              "Id": "ProvideYearsOfExperienceInUsingClimateData"
            }
          ],
          "Label": "Provide background information",
          "Id": "ProvideBackgroundInformation"
        },
        {
          "AssociatedEntities": "Text",
          "Range": "No",
          "InformationType": "Obligatory",
          "Role": [
            "InformationRequester"
          ],
          "Description": "The operation that provides climate case information such as spatial region and planning time range.",
          "AssociatedData": {
            "type": "text"
          },
          "Specializations": [
            {
              "AssociatedEntities": "Text",
              "Range": "No",
              "InformationType": "Obligatory",
              "Role": [
                "InformationRequester",
                "CaseCreator"
              ],
              "Description": "The operation that provides a title for the case.",
              "AssociatedData": {
                "type": "text"
              },
              "Label": "Add case title",
              "Id": "AddCaseTitle"
            },
            {
              "AssociatedEntities": "Text",
              "Range": "No",
              "InformationType": "Obligatory",
              "Role": [
                "InformationRequester"
              ],
              "Description": "The operation that states the climate-related challenges faced by the organisation or by its operational activities.",
              "AssociatedData": {
                "type": "text"
              },
              "Label": "Define customer needs",
              "Id": "DefineCustomerNeeds"
            },
            {
              "AssociatedEntities": "Text",
              "Range": "No",
              "InformationType": "Optional",
              "Role": [
                "InformationRequester"
              ],
              "Description": "The operation that states the main goals for which the customer is seeking climate information.",
              "AssociatedData": {
                "type": "text"
              },
              "Label": "Define request goal",
              "Id": "DefineRequestGoal"
            },
            {
              "AssociatedEntities": "Date",
              "Range": "No",
              "InformationType": "Optional",
              "Role": [
                "InformationRequester",
                "CaseCreator"
              ],
              "Description": "The operation that sets a deadline (a date in the form MM/YYYY) for climate intelligence provision.",
              "AssociatedData": {
                "type": "date"
              },
              "Label": "Add expected deadline",
              "Id": "AddExpectedDeadline"
            },
            {
              "AssociatedEntities": "Text",
              "Range": "No",
              "InformationType": "Optional",
              "Role": [
                "CaseCreator"
              ],
              "Description": "The operation that estimates the required resources (e.g., human, computational, financial).",
              "AssociatedData": {
                "type": "text"
              },
              "Label": "Add required resources",
              "Id": "AddRequiredResources"
            },
            {
              "AssociatedEntities": "Spatial region",
              "Range": "No",
              "Output": "Spatial region (custom or predefined cordex domain)",
              "InformationType": "Obligatory",
              "Role": [
                "InformationRequester",
                "CaseCreator"
              ],
              "Description": "The operation that indicates the geographic area of interest.",
              "AssociatedData": {
                "type": "geodetic-region"
              },
              "Label": "Indicate spatial region",
              "Id": "IndicateSpatialRegion"
            },
            {
              "AssociatedEntities": "Date (range)",
              "Range": "Yes",
              "Output": "Time range",
              "InformationType": "Obligatory",
              "Role": [
                "InformationRequester",
                "CaseCreator"
              ],
              "Description": "The operation that states the overall time horizon over which the climate information is required. If multiple horizons are of interest, provide the time horizon that covers them all. In case such information is not available or not explicitly defined, provide the typical time horizon for organisations' planning decisions.\n",
              "AssociatedData": {
                "type": "range",
                "items": {
                  "type": "date"
                }
              },
              "Label": "Define planning time horizon",
              "Id": "DefinePlanningTimeHorizon"
            }
          ],
          "Label": "Provide climate case information",
          "Id": "ProvideClimateCaseInformation"
        },
        {
          "AssociatedEntities": "Text",
          "Range": "No",
          "InformationType": "Obligatory",
          "Role": [
            "InformationRequester",
            "CaseCreator"
          ],
          "Description": "The operation that provides decision context information.",
          "AssociatedData": {
            "type": "text"
          },
          "Specializations": [
            {
              "AssociatedEntities": "Text",
              "Range": "No",
              "InformationType": "Obligatory",
              "Comment": "Each case can have one or more climate questions, and that each climate question can be associated to one or more hazards.",
              "Role": [
                "InformationRequester"
              ],
              "Description": "The operation that formulates key questions related to climate information that the customer seeks to answer.",
              "AssociatedData": {
                "type": "text"
              },
              "Label": "Formulate climate questions",
              "Id": "FormulateClimateQuestions"
            },
            {
              "AssociatedEntities": "Hazard",
              "Range": "No",
              "Output": "Relevant Hazard",
              "InformationType": "Obligatory",
              "Role": [
                "InformationRequester",
                "CaseCreator"
              ],
              "Description": "The operation that identifies the climate hazards (a climate-related physical event or process) that impact the customer organisation.",
              "AssociatedData": {
                "type": "uri",
                "cv": "Hazard"
              },
              "Label": "Identify hazards",
              "Id": "IdentifyHazards"
            },
            {
              "AssociatedEntities": "Text",
              "Range": "No",
              "BackwardDependency": "Identify hazards",
              "InformationType": "Optional",
              "Role": [
                "InformationRequester"
              ],
              "Description": "The operation that describes how climate hazards impact the organisation's activities and the proposed case. ",
              "AssociatedData": {
                "type": "text"
              },
              "Label": "Describe climate hazard impacts",
              "Id": "DescribeClimateHazardImpacts"
            },
            {
              "AssociatedEntities": "Text",
              "Range": "No",
              "InformationType": "Optional",
              "Role": [
                "InformationRequester",
                "CaseCreator"
              ],
              "Description": "The operation that lists decisions or actions that could be better informed with improved climate information for the identified hazards.",
              "AssociatedData": {
                "type": "text"
              },
              "Label": "Specify decision context",
              "Id": "SpecifyDecisionContext"
            },
            {
              "AssociatedEntities": "Text",
              "Range": "No",
              "InformationType": "Optional",
              "Role": [
                "InformationRequester",
                "CaseCreator"
              ],
              "Description": "The operation that outlines the organisational standard practices regarding the identified hazards",
              "AssociatedData": {
                "type": "text"
              },
              "Label": "Provide information on organisational standards",
              "Id": "ProvideInformationOnOrganisationalStandards"
            },
            {
              "AssociatedEntities": "Text",
              "Range": "No",
              "InformationType": "Optional",
              "Role": [
                "InformationRequester",
                "CaseCreator"
              ],
              "Description": "The operation that identifies the presence of people, assets, resources, or activities in places and settings potentially affected by the identified hazards.",
              "AssociatedData": {
                "type": "text"
              },
              "Label": "Provide information on exposure identification",
              "Id": "ProvideInformationOnExposureIdentification"
            },
            {
              "AssociatedEntities": "Text",
              "Range": "No",
              "InformationType": "Optional",
              "Role": [
                "InformationRequester",
                "CaseCreator"
              ],
              "Description": "The operation that collects information regarding how susceptible a system, asset or population is to the climate hazards. It reflects lack of capacity to cope with or adapt to impacts. High vulnerability often reduces risk tolerance.",
              "AssociatedData": {
                "type": "text"
              },
              "Label": "Provide information on vulnerability identification",
              "Id": "ProvideInformationOnVulnerabilityIdentification"
            },
            {
              "AssociatedEntities": "Risk rating",
              "Range": "No",
              "InformationType": "Optional",
              "Comment": "low - medium - high",
              "Role": [
                "InformationRequester"
              ],
              "Description": "The operation that rates risk tolerance, i.e. a measure of the extent to which a user is willing to accept uncertainty and potential adverse outcomes related to climate risks: for example, a low risk tolerance indicates a preference for detailed quantification of even the most extreme climate scenarios, enabling proactive planning and adaptation to minimise potential impacts.",
              "AssociatedData": {
                "type": "uri",
                "cv": "RiskRating"
              },
              "Label": "Rate risk tolerance",
              "Id": "RateRiskTolerance"
            },
            {
              "AssociatedEntities": "Text",
              "Range": "No",
              "InformationType": "Optional",
              "Role": [
                "InformationRequester",
                "CaseCreator"
              ],
              "Description": "The operation that specifies the climate risk framing (e.g., loss probability, combination of hazard, exposure and vulnerability: risk index, etc.)",
              "AssociatedData": {
                "type": "text"
              },
              "Label": "Specify climate risk framing",
              "Id": "SpecifyClimateRiskFraming"
            }
          ],
          "Label": "Provide decision context information",
          "Id": "ProvideDecisionContextInformation"
        }
      ],
      "Label": "Create case",
      "Id": "CreateCase"
    },
    {
      "InformationType": "Optional",
      "Role": [
        "CaseSolver"
      ],
      "Description": "The operation that requests external expertise such as an expert or literature review.",
      "Specializations": [
        {
          "AssociatedEntities": "Text",
          "Range": "No",
          "Output": "Literature review",
          "InformationType": "Optional",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that looks for additional information from existing literature.",
          "AssociatedData": {
            "type": "text"
          },
          "Label": "Perform literature review",
          "Id": "PerformLiteratureReview"
        },
        {
          "AssociatedEntities": "Text",
          "Range": "No",
          "Output": "Domain expert advice",
          "InformationType": "Optional",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that requests external expertise from an expert.",
          "AssociatedData": {
            "type": "text"
          },
          "Label": "Search for external expertise",
          "Id": "SearchForExternalExpertise"
        }
      ],
      "Label": "Search additional Information",
      "Id": "SearchAdditionalInformation"
    },
    {
      "InformationType": "Obligatory",
      "Role": [
        "CaseSolver"
      ],
      "Description": "The operation that prepares the climate information.",
      "Specializations": [
        {
          "AssociatedEntities": "Index; variable",
          "Range": "No",
          "Output": "Indices or variables",
          "InformationType": "Obligatory",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that identifies the climate indices (e.g., number of tropical nights per calendar year, standardised precipitation index) or variables (e.g.,  max temperature, monthly rainfall) if no suitable indicator is found relevant to the study or decision-making context.",
          "AssociatedData": {
            "type": "uri",
            "cv": "Index; variable"
          },
          "Label": "Identify indices and variables",
          "Id": "IdentifyIndicesAndVariables"
        },
        {
          "AssociatedEntities": "Date",
          "Range": "Yes",
          "Output": "Time range (custom selected)",
          "InformationType": "Optional",
          "Comment": "Not always needed - if absolute values are used in output and no comparison to observations are made",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that chooses a historical reference period (e.g., 1850–1900 as pre-industrial baseline, 1986–2005 in IPCC AR5, 1995–2014 in IPCC AR6) to serve as a baseline for comparing future climate projections or for global warming level extraction",
          "AssociatedData": {
            "type": "range",
            "items": {
              "type": "date"
            }
          },
          "Label": "Choose baseline period",
          "Id": "ChooseBaselinePeriod"
        },
        {
          "AssociatedEntities": "Date",
          "Range": "Yes",
          "ForwardDependecy": "Define emission scenarios",
          "Conflict": "Choose global warming level",
          "Output": "Time range (custom selected)",
          "InformationType": "Conditional",
          "Condition": "Obligatory if GWL is not selected",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that chooses the future time horizons of interest (e.g., specific period in the future like 2080–2100, 2030–2080) for climate information or risk or impact assessment.",
          "AssociatedData": {
            "type": "range",
            "items": {
              "type": "date"
            }
          },
          "Label": "Choose future period",
          "Id": "ChooseFuturePeriod"
        },
        {
          "AssociatedEntities": "Global warming level",
          "Range": "Optional",
          "ForwardDependecy": "Choose global warming level extraction method",
          "Conflict": "Choose future period",
          "Output": "Selected GWL (specific value or range)",
          "InformationType": "Conditional",
          "Condition": "Obligatory if future period is not selected",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that selects specific global warming levels (e.g., +1.5°C, +2°C).",
          "AssociatedData": {
            "type": "range-or-exact",
            "items": {
              "type": "uri",
              "cv": "Global warming level"
            }
          },
          "Label": "Choose global warming level",
          "Id": "ChooseGlobalWarmingLevel"
        },
        {
          "AssociatedEntities": "Method",
          "Range": "No",
          "BackwardDependency": "Choose global warming level",
          "ForwardDependecy": "Filter climate simulations by global warming level exceedance",
          "Input": "Time range (optional)",
          "Output": "GWL extraction method",
          "InformationType": "Conditional",
          "Condition": "Obligatory if task \"Global warming level choice\" is selected",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that chooses a method to extract regional climate change data in relation to selected global warming levels above pre-industrial (default: 1850-1900).",
          "AssociatedData": {
            "type": "uri",
            "cv": "Method"
          },
          "Label": "Choose global warming level extraction method",
          "Id": "ChooseGlobalWarmingLevelExtractionMethod"
        },
        {
          "AssociatedEntities": "Emission scenario",
          "Range": "Optional",
          "Output": "Selected emission scenario",
          "InformationType": "Conditional",
          "Condition": "Obligatory if future period choice is used",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that defines appropriate representative concentration pathways (RCPs) or shared socioeconomic\npathways (SSPs) to explore a range of future climate outcomes.",
          "AssociatedData": {
            "type": "range-or-exact",
            "items": {
              "type": "uri",
              "cv": "Emission scenario"
            }
          },
          "Label": "Define emission scenarios",
          "Id": "DefineEmissionScenarios"
        },
        {
          "AssociatedEntities": "Spatial resolution",
          "Range": "Optional",
          "Output": "Selected spatial resolution range",
          "InformationType": "Obligatory",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that selects the required spatial resolution (e.g., 1 km, 60 km, 0.25°) range for the output climate data.",
          "AssociatedData": {
            "type": "range-or-exact",
            "items": {
              "type": "number"
            }
          },
          "Label": "Define relevant spatial resolutions",
          "Id": "DefineRelevantSpatialResolutions"
        },
        {
          "AssociatedEntities": "Temporal resolution",
          "Range": "Optional",
          "Output": "Selected temporal resolution range",
          "InformationType": "Obligatory",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that selects the required temporal resolution (e.g., daily, monthly, annual, seasonal) range for the output climate data.",
          "AssociatedData": {
            "type": "range-or-exact",
            "items": {
              "type": "duration"
            }
          },
          "Label": "Define relevant temporal resolutions",
          "Id": "DefineRelevantTemporalResolutions"
        },
        {
          "AssociatedEntities": "Sub-annual period",
          "Range": "Optional",
          "Output": "Subseasonal slice",
          "InformationType": "Optional",
          "Condition": "For possible values, see Table 1 of this document: https://docs.google.com/document/d/1svoQ4lW1i4nFaPWZEzIxQakPmS_sDS4uO9yy9OmeSQo/edit?tab=t.0",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that selects a sub-annual period (e.g. month, season, period in year) of interest (e.g. boreal winter (DJFM), austral spring (SON), Januarys, Julys).",
          "AssociatedData": {
            "type": "range-or-exact",
            "items": {
              "type": "uri",
              "cv": "Sub-annual period"
            }
          },
          "Label": "Define subannual selection",
          "Id": "DefineSubannualSelection"
        },
        {
          "AssociatedEntities": "Observation type",
          "Range": "No",
          "Output": "Observation type",
          "InformationType": "Obligatory",
          "Condition": "CV would only be \"station-based\" and \"gridded\". \"station-based\" refers to observations collected at a specific geographic point, \"gridded\" refers to observations interpolated or modelled onto a regular grid of cells. I think it can be related to \"GeodeticPoint\" and \"RegularGrid\" respectively.",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that defines the preferred observation type (e.g., station-based, gridded).",
          "AssociatedData": {
            "type": "uri",
            "cv": "Observation type"
          },
          "Label": "Define observation type",
          "Id": "DefineObservationType"
        },
        {
          "AssociatedEntities": "Access point",
          "Range": "No",
          "Output": "Access point organisation or country of origin",
          "InformationType": "Optional",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that chooses the preferred source for climate simulation data access (access point: e.g., ESGF datanodes, Copernicus CDS, OpenDAP, national portals).",
          "AssociatedData": {
            "type": "uri",
            "cv": "Access point"
          },
          "Label": "Define preferred access point",
          "Id": "DefinePreferredAccessPoint"
        },
        {
          "AssociatedEntities": "Text",
          "Range": "No",
          "Output": "Additional selection criteria for climate simulations",
          "InformationType": "Optional",
          "Comment": "free text to be possibly parsed and linked. In the description, added a request to provide URIs",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that provides additional constraints to the climate simulation selection like origin of source (e.g., institution, country of origin), etc. Provide information with URIs taken from the KG where possible.",
          "AssociatedData": {
            "type": "text"
          },
          "Label": "Provide additional climate simulation selection criteria",
          "Id": "ProvideAdditionalClimateSimulationSelectionCriteria"
        },
        {
          "AssociatedEntities": "Text",
          "Range": "No",
          "Output": "Additional selection criteria for observations",
          "InformationType": "Optional",
          "Comment": "free text to be possibly parsed and linked. In the description, added a request to provide URIs",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that provides additional constraints to the observation selection, such as the origin of the source (e.g., institution, country of origin), etc. Provide information with URIs taken from the KG where possible.",
          "AssociatedData": {
            "type": "text"
          },
          "Label": "Provide additional observation selection criteria",
          "Id": "ProvideAdditionalObservationSelectionCriteria"
        },
        {
          "BackwardDependency": "Identify indices and variables",
          "Input": "All relevant filtering dimensions",
          "Output": "List of climate simulations",
          "InformationType": "Optional",
          "Condition": "Obligatory if case solver decides not to manually select the climate simulations or use impact models instead",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that applies filtering criteria to the list of climate simulations and shortlisting matching entries.",
          "Label": "Filter climate simulations by selection criteria",
          "Id": "FilterClimateSimulationsBySelectionCriteria"
        },
        {
          "BackwardDependency": "Identify indices and variables",
          "Input": "All relevant filtering dimensions",
          "Output": "List of observation datasets",
          "InformationType": "Optional",
          "Condition": "Obligatory if case solver decides not to manually select the observations",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that applies filtering criteria to the list of observations and shortlisting matching entries.",
          "Label": "Filter observations by selection criteria",
          "Id": "FilterObservationsBySelectionCriteria"
        },
        {
          "AssociatedEntities": "Climate simulations",
          "Range": "No",
          "BackwardDependency": "Filter climate simulations by selection criteria",
          "Output": "List of climate simulations",
          "InformationType": "Optional",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that selects the climate simulations",
          "AssociatedData": {
            "type": "uri",
            "cv": "Climate simulations"
          },
          "Label": "Conduct manual selection of climate simulations",
          "Id": "ConductManualSelectionOfClimateSimulations"
        },
        {
          "AssociatedEntities": "Observation datasets",
          "Range": "No",
          "BackwardDependency": "Filter observations by selection criteria",
          "Output": "List of observation datasets",
          "InformationType": "Optional",
          "Role": [
            "CaseSolver"
          ],
          "Description": "The operation that selects the observations",
          "AssociatedData": {
            "type": "uri",
            "cv": "Observation datasets"
          },
          "Label": "Conduct manual selection of observations",
          "Id": "ConductManualSelectionOfObservations"
        },
        {
          "BackwardDependency": "Choose global warming level",
          "Conflict": "Apply pattern scaling",
          "Input": "GWL range; GWL extraction method; if scenario-based, emission scenario definition",
          "Output": "List of climate simulations (with associated global warming exceeding selected GWL)",
          "InformationType": "Conditional",
          "Condition": "Obligatory if task \"Global warming level choice\" is selected and \"Global warming level extraction method\" is not \"Pattern scaling\"",
          "Comment": "Simulations need to be retrieved at this stage to do this - but only GCMs, not RCMs",
