              "Input": "Model performance metric",
              "Output": "Processed climate simulation data (selection)",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Conditional",
                "Condition": "Obligatory if \"Climate simulation evaluation\" is conducted",
                "BackwardDependencies": [
                  "Evaluate climate simulations"
                ]
              },
              "Description": "The operation that rejects the climate model simulations that do not meet the evaluation criteria or the ad hoc selection by the case solver.",
              "@type": "top:Operation",
              "Label": "Select climate simulations",
              "@id": "ops:SelectClimateSimulations",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:SelectClimateSimulations/associated-data",
                  "ExpectedType": {
                    "@id": "top:Method",
                    "@type": "owl:Class"
                  }
                }
              ]
            }
          ],
          "@type": "top:Operation",
          "Label": "Prepare climate information",
          "@id": "ops:PrepareClimateInformation"
        },
        {
          "WorkflowInfo": {
            "Roles": [
              "CaseSolver"
            ],
            "InformationType": "Conditional",
            "Condition": "If not pursued, climate impact assessment is obligatory"
          },
          "Description": "The operation that analyses the climate information to understand what future climatic changes are simulated and associated uncertainties.",
          "Specializations": [
            {
              "Input": "Processed climate simulation data (selection)",
              "Output": "Output metric",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Obligatory",
                "BackwardDependencies": [
                  "Select climate simulations"
                ]
              },
              "Description": "The operation that analyses and projecting the future climate by creating an output metric based on the selected climate simulations.",
              "@type": "top:Operation",
              "Label": "Quantify future climate change",
              "@id": "ops:QuantifyFutureClimateChange",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
