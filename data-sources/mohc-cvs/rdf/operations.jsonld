              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that provides additional constraints to the observation selection, such as the origin of the source (e.g., institution, country of origin), etc. Provide information with URIs taken from the KG where possible.",
              "@type": "top:Operation",
