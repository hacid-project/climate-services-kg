{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "top": "https://w3id.org/hacid/onto/top-level/",
    "ccso": "https://w3id.org/hacid/onto/ccso/",
    "data": "https://w3id.org/hacid/onto/data/",
    "index": "https://w3id.org/hacid/data/cs/metoffice/indices/",
    "sector": "https://w3id.org/hacid/data/cs/climdex/sectors/",
    "parameter": "https://w3id.org/hacid/data/cs/climdex/parameters/",
    "variable": "https://w3id.org/hacid/data/cs/variables/mip/",
    "unit": "https://w3id.org/hacid/data/cs/unitsofmeasure/",
    "dimension": "https://w3id.org/hacid/data/cs/dimensions/",
    "aggregation": "https://w3id.org/hacid/data/cs/climdex/index-time-aggregations/",
    "temporalgrid": "https://w3id.org/hacid/data/cs/dimensions/time/reference-frames/gregorian/quantizations/",
    "ops": "https://w3id.org/hacid/data/cs/wf/ops/",
    "schemes": "https://w3id.org/hacid/data/cs/wf/schemes/",
    "collections": "https://w3id.org/hacid/data/cs/wf/collections/",
    "Id": "@id",
    "Label": "rdfs:label",
    "Description": "rdfs:comment",
    "Specializations": "top:isSpecializedBy",
    "ExpectedType": "top:hasExpectedType",
    "InformationRoles": "top:definesRole",
    "unionOf": {
      "@id": "owl:unionOf",
      "@type": "@id",
      "@container": "@list"
    },
    "intersectionOf": {
      "@id": "owl:intersectionOf",
      "@type": "@id",
      "@container": "@list"
    },
    "onProperty": {
      "@id": "owl:onProperty",
      "@type": "@id"
    }
  },
  "@id": "ops:CaseOperation",
  "@type": "top:Operation",
  "Label": "Case operation",
  "Specializations": [
    {
      "Specializations": [
        {
          "WorkflowInfo": {
            "Roles": [
              "InformationRequester"
            ],
            "InformationType": "Obligatory"
          },
          "Description": "The operation that requests the climate information.",
          "@type": "top:Operation",
          "Label": "Request climate information",
          "@id": "ops:RequestClimateInformation"
        },
        {
          "WorkflowInfo": {
            "Roles": [
              "CaseCreator"
            ],
            "InformationType": "Obligatory"
          },
          "Description": "The operation that requests user background information.",
          "@type": "top:Operation",
          "Label": "Request user background information",
          "@id": "ops:RequestUserBackgroundInformation"
        },
        {
          "WorkflowInfo": {
            "Roles": [
              "InformationRequester",
              "CaseCreator"
            ],
            "InformationType": "Obligatory"
          },
          "Description": "The operation that provides background information such as information about the organization and their climate information needs",
          "Specializations": [
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester"
                ],
                "InformationType": "Obligatory"
              },
              "Description": "The operation that provides the name of the customer organization.",
              "@type": "top:Operation",
              "Label": "Provide organization name",
              "@id": "ops:ProvideOrganizationName",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:ProvideOrganizationName/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester"
                ],
                "InformationType": "Obligatory"
              },
              "Description": "The operation that describes the type of the customer organization.",
              "@type": "top:Operation",
              "Label": "Describe organization type",
              "@id": "ops:DescribeOrganizationType",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:DescribeOrganizationType/associated-data",
                  "ExpectedType": {
                    "@type": "owl:Restriction",
                    "onProperty": "top:inScheme",
                    "owl:hasValue": "schemes:OrganizationType"
                  }
                }
              ]
            },
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that describes the size (e.g. small, medium, large) of the customer organization.",
              "@type": "top:Operation",
              "Label": "Describe organization size",
              "@id": "ops:DescribeOrganizationSize",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:DescribeOrganizationSize/associated-data",
                  "ExpectedType": {
                    "@type": "owl:Restriction",
                    "onProperty": "top:inScheme",
                    "owl:hasValue": "schemes:OrganizationSize"
                  }
                }
              ]
            },
            {
              "Comment": "Can use sectors associated with hazards",
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that describes the operating sector of the customer organization.",
              "@type": "top:Operation",
              "Label": "Describe organization operating sector",
              "@id": "ops:DescribeOrganizationOperatingSector",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:DescribeOrganizationOperatingSector/associated-data",
                  "ExpectedType": {
                    "@type": "owl:Restriction",
                    "onProperty": "top:inScheme",
                    "owl:hasValue": "https://w3id.org/hacid/data/cs/climdex/sectors"
                  }
                }
              ]
            },
            {
              "Comment": "Can be described in one of the text fields regarding the case",
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that quantifies years of experience in using climate data",
              "@type": "top:Operation",
              "Label": "Provide years of experience in using climate data",
              "@id": "ops:ProvideYearsOfExperienceInUsingClimateData",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:ProvideYearsOfExperienceInUsingClimateData/associated-data",
                  "ExpectedType": {
                    "intersectionOf": [
                      {
                        "@type": "owl:Restriction",
                        "onProperty": "owl:onDatatype",
                        "owl:allValuesFrom": {
                          "@id": "xsd:decimal",
                          "@type": "rdfs:Datatype"
                        }
                      },
                      {
                        "@type": "owl:Restriction",
                        "onProperty": "owl:withRestrictions",
                        "owl:cardinality": 1
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "@type": "top:Operation",
          "Label": "Provide background information",
          "@id": "ops:ProvideBackgroundInformation",
          "InformationRoles": [
            {
              "@type": "top:InformationRole",
              "@id": "ops:ProvideBackgroundInformation/associated-data",
              "ExpectedType": {
                "@id": "xsd:string",
                "@type": "rdfs:Datatype"
              }
            }
          ]
        },
        {
          "WorkflowInfo": {
            "Roles": [
              "InformationRequester"
            ],
            "InformationType": "Obligatory"
          },
          "Description": "The operation that provides climate case information such as spatial region and planning time range.",
          "Specializations": [
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester",
                  "CaseCreator"
                ],
                "InformationType": "Obligatory"
              },
              "Description": "The operation that provides a title for the case.",
              "@type": "top:Operation",
              "Label": "Add case title",
              "@id": "ops:AddCaseTitle",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:AddCaseTitle/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester"
                ],
                "InformationType": "Obligatory"
              },
              "Description": "The operation that states the climate-related challenges faced by the organization or by its operational activities.",
              "@type": "top:Operation",
              "Label": "Define customer needs",
              "@id": "ops:DefineCustomerNeeds",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:DefineCustomerNeeds/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that states the main goals for which the customer is seeking climate information.",
              "@type": "top:Operation",
              "Label": "Define request goal",
              "@id": "ops:DefineRequestGoal",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:DefineRequestGoal/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester",
                  "CaseCreator"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that sets a deadline (a date in the form MM/YYYY) for climate intelligence provision.",
              "@type": "top:Operation",
              "Label": "Add expected deadline",
              "@id": "ops:AddExpectedDeadline",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:AddExpectedDeadline/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:date",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "WorkflowInfo": {
                "Roles": [
                  "CaseCreator"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that estimates the required resources (e.g., human, computational, financial).",
              "@type": "top:Operation",
              "Label": "Add required resources",
              "@id": "ops:AddRequiredResources",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:AddRequiredResources/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "Output": "Spatial region (custom or predefined cordex domain)",
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester",
                  "CaseCreator"
                ],
                "InformationType": "Obligatory"
              },
              "Description": "The operation that indicates the geographic area of interest.",
              "@type": "top:Operation",
              "Label": "Indicate spatial region",
              "@id": "ops:IndicateSpatialRegion",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:IndicateSpatialRegion/associated-data",
                  "ExpectedType": {
                    "@id": "data:GeodeticRegion",
                    "@type": "owl:Class"
                  }
                }
              ]
            },
            {
              "Output": "Time range",
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester",
                  "CaseCreator"
                ],
                "InformationType": "Obligatory"
              },
              "Description": "The operation that states the overall time horizon over which the climate information is required. If multiple horizons are of interest, provide the time horizon that covers them all. In case such information is not available or not explicitly defined, provide the typical time horizon for organizations' planning decisions.\n",
              "@type": "top:Operation",
              "Label": "Define planning time horizon",
              "@id": "ops:DefinePlanningTimeHorizon",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:DefinePlanningTimeHorizon/associated-data",
                  "ExpectedType": {
                    "intersectionOf": [
                      {
                        "@type": "owl:Restriction",
                        "onProperty": "owl:onDatatype",
                        "owl:allValuesFrom": {
                          "@id": "xsd:date",
                          "@type": "rdfs:Datatype"
                        }
                      },
                      {
                        "@type": "owl:Restriction",
                        "onProperty": "owl:withRestrictions",
                        "owl:cardinality": 1
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "@type": "top:Operation",
          "Label": "Provide climate case information",
          "@id": "ops:ProvideClimateCaseInformation",
          "InformationRoles": [
            {
              "@type": "top:InformationRole",
              "@id": "ops:ProvideClimateCaseInformation/associated-data",
              "ExpectedType": {
                "@id": "xsd:string",
                "@type": "rdfs:Datatype"
              }
            }
          ]
        },
        {
          "WorkflowInfo": {
            "Roles": [
              "InformationRequester",
              "CaseCreator"
            ],
            "InformationType": "Obligatory"
          },
          "Description": "The operation that provides decision context information.",
          "Specializations": [
            {
              "Comment": "Each case can have one or more climate questions, and that each climate question can be associated to one or more hazards.",
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester"
                ],
                "InformationType": "Obligatory"
              },
              "Description": "The operation that formulates key questions related to climate information that the customer seeks to answer.",
              "@type": "top:Operation",
              "Label": "Formulate climate questions",
              "@id": "ops:FormulateClimateQuestions",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:FormulateClimateQuestions/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "Output": "Relevant Hazard",
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester",
                  "CaseCreator"
                ],
                "InformationType": "Obligatory"
              },
              "Description": "The operation that identifies the climate hazards (a climate-related physical event or process) that impact the customer organization.",
              "@type": "top:Operation",
              "Label": "Identify hazards",
              "@id": "ops:IdentifyHazards",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:IdentifyHazards/associated-data",
                  "ExpectedType": {
                    "@id": "ccso:HazardType",
                    "@type": "owl:Class"
                  }
                }
              ]
            },
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester"
                ],
                "InformationType": "Optional",
                "BackwardDependencies": [
                  "Identify hazards"
                ]
              },
              "Description": "The operation that describes how climate hazards impact the organization's activities and the proposed case. ",
              "@type": "top:Operation",
              "Label": "Describe climate hazard impacts",
              "@id": "ops:DescribeClimateHazardImpacts",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:DescribeClimateHazardImpacts/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester",
                  "CaseCreator"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that lists decisions or actions that could be better informed with improved climate information for the identified hazards.",
              "@type": "top:Operation",
              "Label": "Specify decision context",
              "@id": "ops:SpecifyDecisionContext",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:SpecifyDecisionContext/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester",
                  "CaseCreator"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that outlines the organizational standard practices regarding the identified hazards",
              "@type": "top:Operation",
              "Label": "Provide information on organizational standards",
              "@id": "ops:ProvideInformationOnOrganizationalStandards",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:ProvideInformationOnOrganizationalStandards/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester",
                  "CaseCreator"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that identifies the presence of people, assets, resources, or activities in places and settings potentially affected by the identified hazards.",
              "@type": "top:Operation",
              "Label": "Provide information on exposure identification",
              "@id": "ops:ProvideInformationOnExposureIdentification",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:ProvideInformationOnExposureIdentification/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester",
                  "CaseCreator"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that collects information regarding how susceptible a system, asset or population is to the climate hazards. It reflects lack of capacity to cope with or adapt to impacts. High vulnerability often reduces risk tolerance.",
              "@type": "top:Operation",
              "Label": "Provide information on vulnerability identification",
              "@id": "ops:ProvideInformationOnVulnerabilityIdentification",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:ProvideInformationOnVulnerabilityIdentification/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "Comment": "low - medium - high",
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that rates risk tolerance, i.e. a measure of the extent to which a user is willing to accept uncertainty and potential adverse outcomes related to climate risks: for example, a low risk tolerance indicates a preference for detailed quantification of even the most extreme climate scenarios, enabling proactive planning and adaptation to minimise potential impacts.",
              "@type": "top:Operation",
              "Label": "Rate risk tolerance",
              "@id": "ops:RateRiskTolerance",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:RateRiskTolerance/associated-data",
                  "ExpectedType": {
                    "@type": "owl:Restriction",
                    "onProperty": "top:inScheme",
                    "owl:hasValue": "schemes:RiskRating"
                  }
                }
              ]
            },
            {
              "WorkflowInfo": {
                "Roles": [
                  "InformationRequester",
                  "CaseCreator"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that specifies the climate risk framing (e.g., loss probability, combination of hazard, exposure and vulnerability: risk index, etc.)",
              "@type": "top:Operation",
              "Label": "Specify climate risk framing",
              "@id": "ops:SpecifyClimateRiskFraming",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:SpecifyClimateRiskFraming/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            }
          ],
          "@type": "top:Operation",
          "Label": "Provide decision context information",
          "@id": "ops:ProvideDecisionContextInformation",
          "InformationRoles": [
            {
              "@type": "top:InformationRole",
              "@id": "ops:ProvideDecisionContextInformation/associated-data",
              "ExpectedType": {
                "@id": "xsd:string",
                "@type": "rdfs:Datatype"
              }
            }
          ]
        }
      ],
      "@type": "top:Operation",
      "Label": "Create case",
      "@id": "ops:CreateCase"
    },
    {
      "@id": "ops:HandleCase",
      "@type": "top:Operation",
      "Label": "Handle case",
      "Specializations": [
        {
          "WorkflowInfo": {
            "Roles": [
              "CaseSolver"
            ],
            "InformationType": "Optional"
          },
          "Description": "The operation that requests external expertise such as an expert or literature review.",
          "Specializations": [
            {
              "Output": "Literature review",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that looks for additional information from existing literature.",
              "@type": "top:Operation",
              "Label": "Perform literature review",
              "@id": "ops:PerformLiteratureReview",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:PerformLiteratureReview/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "Output": "Domain expert advice",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that requests external expertise from an expert.",
              "@type": "top:Operation",
              "Label": "Search for external expertise",
              "@id": "ops:SearchForExternalExpertise",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:SearchForExternalExpertise/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            },
            {
              "Output": "Non-climatic data description",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Optional"
              },
              "Description": "The task of describing the non-climatic information.",
              "@type": "top:Operation",
              "Label": "Provide non-climatic information",
              "@id": "ops:ProvideNonClimaticInformation",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:ProvideNonClimaticInformation/associated-data",
                  "ExpectedType": {
                    "@id": "xsd:string",
                    "@type": "rdfs:Datatype"
                  }
                }
              ]
            }
          ],
          "@type": "top:Operation",
          "Label": "Search additional information",
          "@id": "ops:SearchAdditionalInformation"
        },
        {
          "WorkflowInfo": {
            "Roles": [
              "CaseSolver"
            ],
            "InformationType": "Obligatory"
          },
          "Description": "The operation that prepares the climate information.",
          "Specializations": [
            {
              "Output": "Indices or variables",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Obligatory"
              },
              "Description": "The operation that identifies the climate indices (e.g., number of tropical nights per calendar year, standardised precipitation index) or variables (e.g.,  max temperature, monthly rainfall) if no suitable indicator is found relevant to the study or decision-making context.",
              "@type": "top:Operation",
              "Label": "Identify indices and variables",
              "@id": "ops:IdentifyIndicesAndVariables",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:IdentifyIndicesAndVariables/associated-data",
                  "ExpectedType": {
                    "@type": "owl:Class",
                    "unionOf": [
                      {
                        "@type": "owl:Restriction",
                        "onProperty": "top:isMemberOf",
                        "owl:hasValue": {
                          "@id": "https://w3id.org/hacid/data/cs/variables"
                        }
                      },
                      {
                        "@type": "owl:Restriction",
                        "onProperty": "top:isMemberOf",
                        "owl:hasValue": {
                          "@id": "https://w3id.org/hacid/data/cs/indices"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Output": "Time range (custom selected)",
              "Comment": "Not always needed - if absolute values are used in output and no comparison to observations are made",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Optional"
              },
              "Description": "The operation that chooses a historical reference period (e.g., 1850–1900 as pre-industrial baseline, 1986–2005 in IPCC AR5, 1995–2014 in IPCC AR6) to serve as a baseline for comparing future climate projections or for global warming level extraction",
              "@type": "top:Operation",
              "Label": "Choose baseline period",
              "@id": "ops:ChooseBaselinePeriod",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:ChooseBaselinePeriod/associated-data",
                  "ExpectedType": {
                    "intersectionOf": [
                      {
                        "@type": "owl:Restriction",
                        "onProperty": "owl:onDatatype",
                        "owl:allValuesFrom": {
                          "@id": "xsd:date",
                          "@type": "rdfs:Datatype"
                        }
                      },
                      {
                        "@type": "owl:Restriction",
                        "onProperty": "owl:withRestrictions",
                        "owl:cardinality": 1
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Conflict": "Choose global warming level",
              "Output": "Time range (custom selected)",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Conditional",
                "Condition": "Obligatory if GWL is not selected",
                "ForwardDependencies": [
                  "Define emission scenarios"
                ]
              },
              "Description": "The operation that chooses the future time horizons of interest (e.g., specific period in the future like 2080–2100, 2030–2080) for climate information or risk or impact assessment.",
              "@type": "top:Operation",
              "Label": "Choose future period",
              "@id": "ops:ChooseFuturePeriod",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:ChooseFuturePeriod/associated-data",
                  "ExpectedType": {
                    "intersectionOf": [
                      {
                        "@type": "owl:Restriction",
                        "onProperty": "owl:onDatatype",
                        "owl:allValuesFrom": {
                          "@id": "xsd:date",
                          "@type": "rdfs:Datatype"
                        }
                      },
                      {
                        "@type": "owl:Restriction",
                        "onProperty": "owl:withRestrictions",
                        "owl:cardinality": 1
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Conflict": "Choose future period",
              "Output": "Selected GWL (specific value or range)",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Conditional",
                "Condition": "Obligatory if future period is not selected",
                "ForwardDependencies": [
                  "Choose global warming level extraction method"
                ]
              },
              "Description": "The operation that selects specific global warming levels (e.g., +1.5°C, +2°C).",
              "@type": "top:Operation",
              "Label": "Choose global warming level",
              "@id": "ops:ChooseGlobalWarmingLevel",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:ChooseGlobalWarmingLevel/associated-data",
                  "ExpectedType": {
                    "@type": "owl:Class",
                    "unionOf": [
                      {
                        "@type": "owl:Restriction",
                        "onProperty": "top:inScheme",
                        "owl:hasValue": "schemes:GlobalWarmingLevel"
                      },
                      {
                        "@type": "owl:Class",
                        "intersectionOf": [
                          "top:Interval",
                          {
                            "@type": "owl:Restriction",
                            "onProperty": "top:hasBoundaryValue",
                            "owl:allValuesFrom": {
                              "@type": "owl:Restriction",
                              "onProperty": "top:inScheme",
                              "owl:hasValue": "schemes:GlobalWarmingLevel"
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Input": "Time range (optional)",
              "Output": "GWL extraction method",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Conditional",
                "Condition": "Obligatory if task \"Global warming level choice\" is selected",
                "BackwardDependencies": [
                  "Choose global warming level"
                ],
                "ForwardDependencies": [
                  "Filter climate simulations by global warming level exceedance",
                  "Apply pattern scaling"
                ]
              },
              "Description": "The operation that chooses a method to extract regional climate change data in relation to selected global warming levels above pre-industrial (default: 1850-1900).",
              "@type": "top:Operation",
              "Label": "Choose global warming level extraction method",
              "@id": "ops:ChooseGlobalWarmingLevelExtractionMethod",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
                  "@id": "ops:ChooseGlobalWarmingLevelExtractionMethod/associated-data",
                  "ExpectedType": {
                    "@id": "top:Method",
                    "@type": "owl:Class"
                  }
                }
              ]
            },
            {
              "Output": "Selected emission scenario",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Conditional",
                "Condition": "Obligatory if future period choice is used"
              },
              "Description": "The operation that defines appropriate representative concentration pathways (RCPs) or shared socioeconomic\npathways (SSPs) to explore a range of future climate outcomes.",
              "@type": "top:Operation",
              "Label": "Define emission scenarios",
              "@id": "ops:DefineEmissionScenarios",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
