              "Input": "Output metric, uncertainty estimate",
              "Output": "Confidence estimate",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Obligatory",
                "BackwardDependencies": [
                  "Quantify future climate change",
                  "Quantify uncertainty"
                ]
              },
              "Description": "The operation that indicates the subjective level of confidence in future climate change and uncertainty quantification.",
              "@type": "top:Operation",
