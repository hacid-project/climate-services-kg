          "@type": "top:Operation",
          "Label": "Analyse climate information",
          "@id": "ops:AnalyseClimateInformation"
        },
        {
          "WorkflowInfo": {
            "Roles": [
              "CaseSolver"
            ],
            "InformationType": "Conditional",
            "Condition": "Only obligatory if climate information analysis is not done."
          },
          "Description": "The operation that conducts the climate impact assessment to understand the impacts of each hazard",
          "Specializations": [
            {
              "Input": "Aggregated climate information or output metric and uncertainty estimate, impact assessment method",
              "Output": "Impact assessment method",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Obligatory"
              },
              "Description": "The operation that identifies models, transfer functions or datasets that can translate climate information into an impact assesment",
