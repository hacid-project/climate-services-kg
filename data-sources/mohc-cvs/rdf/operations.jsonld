                    "@type": "owl:Class"
                  }
                }
              ]
            },
            {
              "Output": "Observation type",
              "WorkflowInfo": {
                "Roles": [
                  "CaseSolver"
                ],
                "InformationType": "Obligatory",
                "Condition": "CV would only be \"station-based\" and \"gridded\". \"station-based\" refers to observations collected at a specific geographic point, \"gridded\" refers to observations interpolated or modelled onto a regular grid of cells. I think it can be related to \"GeodeticPoint\" and \"RegularGrid\" respectively."
              },
              "Description": "The operation that defines the preferred observation type (e.g., station-based, gridded).",
              "@type": "top:Operation",
              "Label": "Define observation type",
              "@id": "ops:DefineObservationType",
              "InformationRoles": [
                {
                  "@type": "top:InformationRole",
