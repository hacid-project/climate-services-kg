@prefix : <https://w3id.org/hacid/data/cs/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix idlab: <http://example.com/idlab/function/> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix top: <https://w3id.org/hacid/onto/top-level/> .
@prefix ccso: <https://w3id.org/hacid/onto/ccso/> .
@prefix data: <https://w3id.org/hacid/onto/data/> .
@prefix dimension: <https://w3id.org/hacid/data/cs/dimensions/> .
@prefix time: <https://w3id.org/hacid/data/cs/dimensions/time/reference-frames/> .
@prefix geodetic: <https://w3id.org/hacid/data/cs/dimensions/geodetic/reference-frames/> .
@prefix geo_specialization_all: <https://w3id.org/hacid/data/cs/dimensions/geodetic/all/specialization> .
@prefix hrf: <https://w3id.org/hacid/rml-functions/> .
@base <https://w3id.org/hacid/data/cs/rml/> .


# LOGICAL SOURCE #
:LogicalSource a rml:BaseSource ;
    rml:source [
      a csvw:Table;
      csvw:url "{{ CSV }}";

      csvw:dialect [
        a csvw:Dialect;
        csvw:delimiter ","
      ]
    ];
    rml:referenceFormulation ql:CSV .

:FormatDatasetCall
    rr:predicate fno:executes ;
    rr:objectMap [ rr:constant hrf:formatCmip5Dataset ] .

:ParamMasterId
    rr:predicate hrf:masterId ;
    rr:objectMap [ rml:reference "master_id" ] .
  
# TRIPLE MAPPINGS #
:DatasetMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;
    
	rr:subjectMap [
        rr:termType rr:IRI ;
        rr:class ccso:SingleProjection, ccso:ScenarioBasedProjection ;
    	rr:template "https://w3id.org/hacid/data/cs/datasets/{master_id}"
    ] ;
	
    rr:predicateObjectMap [
        rr:predicate rdfs:label;
        rr:objectMap [
            rml:reference "master_id"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:isSpecializationOfVariable;
        rr:objectMap :VariableIRI
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:dependsOnVariable ;
        rr:objectMap [
            rr:parentTriplesMap :SpaceVariableMapping
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:dependsOnVariable ;
        rr:objectMap [
            rr:parentTriplesMap :TimeVariableMapping
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:isSpecializedAccordingTo ;
        rr:objectMap [
            rr:parentTriplesMap :TemporalSpecializationMapping
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:isSpecializedAccordingTo ;
        rr:object geo_specialization_all:
    ] ;
    
    rr:predicateObjectMap [
        rr:predicate ccso:refersToScenario ;
        rr:objectMap :EmissionScenarioIRI
    ] .      

:OutputIRI
    rr:termType rr:IRI ;
    rr:class ccso:SingleProjection, ccso:ScenarioBasedProjection ; 
    fnml:functionValue [
        rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
            rr:predicate hrf:template ;
            rr:objectMap [
                rr:constant
                    "https://w3id.org/hacid/data/cs/datasets/cmip5.{model}.{experiment}.{ensemble}.{product}"
            ]
        ] 
    ].

:OutputMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;
    
	rr:subjectMap :OutputIRI ;
	
    rr:predicateObjectMap [
        rr:predicate rdfs:label;
        rr:objectMap [
            rr:language "en" ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
                    rr:predicate hrf:template ;
                    rr:objectMap [
                        rr:constant
                            "cmip5.{model}.{experiment}.{ensemble}.{product}"
                    ]
                ] 
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ccso:outputId;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
                    rr:predicate hrf:template ;
                    rr:objectMap [rr:constant "{product}"]
                ] 
            ]
        ]
    ] ;

   rr:predicateObjectMap [
        rr:predicate rdfs:comment ;
        rr:objectMap [
            rr:language "en" ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant hrf:eval ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate hrf:str ;
                    rr:objectMap [ rml:reference "description" ]
                ] 
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:holdsSpecializationOfVariable;
        rr:objectMap :VariableIRI
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:dependsOnVariable ;
        rr:objectMap [
            rr:parentTriplesMap :SpaceVariableMapping
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate top:hasComponent ;
        rr:objectMap [
            rr:parentTriplesMap :DatasetMapping
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:isSpecializedAccordingTo ;
        rr:object geo_specialization_all:
    ] ;
    
    rr:predicateObjectMap [
        rr:predicate ccso:refersToScenario ;
        rr:objectMap :EmissionScenarioIRI
    ] .      

:EmissionScenarioIRI
    rr:termType rr:IRI ;
    rr:class ccso:GreenhouseGasConcentrationPathway ;
    fnml:functionValue [
        rr:predicateObjectMap [
            rr:predicate fno:executes ;
            rr:objectMap [ rr:constant hrf:getScenario ]
        ] ;
        rr:predicateObjectMap [
            rr:predicate hrf:scenario ;
            rr:objectMap [ 
                fnml:functionValue [
                    rr:predicateObjectMap [
                        rr:predicate fno:executes ;
                        rr:objectMap [ rr:constant hrf:eval ]
                    ];
                    rr:predicateObjectMap [
                        rr:predicate hrf:str ;
                        rr:objectMap [ 
                            rml:reference "experiment"
                        ]
                    ]
                ] 
            ]
        ]         
    ] .

:SimulationIRI
    rr:termType rr:IRI ;
    rr:class ccso:SingleSimulation, ccso:GlobalClimateSimulation ;
    fnml:functionValue [
        rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
            rr:predicate hrf:template ;
            rr:objectMap [
                rr:constant
                    "https://w3id.org/hacid/data/cs/simulations/cmip5.{model}.{experiment}.{ensemble}"
            ]
        ] 
    ] .

:SimulationMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;
    rr:subjectMap :SimulationIRI ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label;
        rr:objectMap [
            rr:language "en" ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
                    rr:predicate hrf:template ;
                    rr:objectMap [
                        rr:constant
                            "cmip5.{model}.{experiment}.{ensemble}"
                    ]
                ] 
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ccso:simulationConfigurationId;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
                    rr:predicate hrf:template ;
                    rr:object "{ensemble}"
                ] 
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:hasOutput ;
        rr:objectMap :OutputIRI
    ] ;

    rr:predicateObjectMap [
        rr:predicate ccso:usesModel ;
        rr:objectMap  [
            rr:parentTriplesMap :ModelMapping
        ] 
    ] ;
    
    rr:predicateObjectMap [
        rr:predicate ccso:refersToScenario ;
        rr:objectMap :EmissionScenarioIRI
    ] .    

:EnsembleIRI
    rr:termType rr:IRI ;
    rr:class ccso:PerturbedParameterClimateEnsembleSimulation, ccso:GlobalClimateSimulation ;
    fnml:functionValue [
        rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
            rr:predicate hrf:template ;
            rr:objectMap [
                rr:constant
                    "https://w3id.org/hacid/data/cs/simulations/cmip5.{model}.{experiment}"
            ]
        ] 
    ] .

:EnsembleMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;
    rr:subjectMap :EnsembleIRI ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label;
        rr:objectMap [
            rr:language "en" ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
                    rr:predicate hrf:template ;
                    rr:objectMap [
                        rr:constant
                            "cmip5.{model}.{experiment}"
                    ]
                ] 
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ccso:hasMemberSimulation ;
        rr:objectMap :SimulationIRI
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:hasOutput ;
        rr:objectMap [
            rr:parentTriplesMap :EnsembleOutputMapping
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ccso:usesModel ;
        rr:objectMap  [
            rr:parentTriplesMap :ModelMapping
        ] 
    ] ;
    
    rr:predicateObjectMap [
        rr:predicate ccso:refersToScenario ;
        rr:objectMap :EmissionScenarioIRI
    ] .    

:EnsembleOutputIRI
    rr:termType rr:IRI ;
    rr:class ccso:EnsembleProjection, ccso:ScenarioBasedProjection ; 
    fnml:functionValue [
        rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
            rr:predicate hrf:template ;
            rr:objectMap [
                rr:constant
                    "https://w3id.org/hacid/data/cs/datasets/cmip5.{model}.{experiment}.{product}"
            ]
        ] 
    ].

:EnsembleOutputMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;
    
	rr:subjectMap :EnsembleOutputIRI ;
	
    rr:predicateObjectMap [
        rr:predicate rdfs:label;
        rr:objectMap [
            rr:language "en" ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
                    rr:predicate hrf:template ;
                    rr:objectMap [
                        rr:constant
                            "cmip5.{model}.{experiment}.{product}"
                    ]
                ] 
            ]
        ]
    ] ;
    
    rr:predicateObjectMap [
        rr:predicate data:holdsSpecializationOfVariable;
        rr:objectMap :VariableIRI
    ] ;

    rr:predicateObjectMap [
        rr:predicate top:hasComponent ;
        rr:objectMap [
            rr:parentTriplesMap :OutputMapping
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:isSpecializedAccordingTo ;
        rr:object geo_specialization_all:
    ] ;
    
    rr:predicateObjectMap [
        rr:predicate ccso:refersToScenario ;
        rr:objectMap :EmissionScenarioIRI
    ] .      

:ExperimentMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;
    rr:subjectMap [
        rr:termType rr:IRI ;
        rr:class ccso:ClimateModelIntercomparisonExperiment, ccso:GlobalClimateSimulation ;
        fnml:functionValue [
            rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
                rr:predicate hrf:template ;
                rr:objectMap [
                    rr:constant
#                        "https://w3id.org/hacid/data/cs/simulations/cmip5.{experiment}"
                        "https://w3id.org/hacid/data/cs/mips/cmip5/experiments/{experiment}"
                ]
            ] 
        ]
    ] ;

    # rr:predicateObjectMap [
    #     rr:predicate rdfs:label;
    #     rr:objectMap [
    #         rr:language "en" ;
    #         fnml:functionValue [
    #             rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
    #                 rr:predicate hrf:template ;
    #                 rr:objectMap [
    #                     rr:constant
    #                         "CMIP5 {experiment}"
    #                 ]
    #             ] 
    #         ]
    #     ]
    # ] ;

    # rr:predicateObjectMap [
    #     rr:predicate top:isComponentOf ;
    #     rr:object <https://w3id.org/hacid/data/cs/mips/cmip5>
    # ] ;

    rr:predicateObjectMap [
        rr:predicate ccso:hasMemberSimulation ;
        rr:objectMap :SimulationIRI
    ] ;

    rr:predicateObjectMap [
        rr:predicate top:hasPart ;
        rr:objectMap :EnsembleIRI
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:hasOutput ;
        rr:objectMap [
            rr:parentTriplesMap :ExperimentOutputMapping
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ccso:refersToScenario ;
        rr:objectMap :EmissionScenarioIRI
    ] .    

:ExperimentOutputIRI
    rr:termType rr:IRI ;
    rr:class ccso:EnsembleProjection, ccso:ScenarioBasedProjection ; 
    fnml:functionValue [
        rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
            rr:predicate hrf:template ;
            rr:objectMap [
                rr:constant
                    "https://w3id.org/hacid/data/cs/datasets/cmip5.{experiment}/output"
            ]
        ] 
    ].

:ExperimentOutputMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;
    
	rr:subjectMap :ExperimentOutputIRI ;
	
    rr:predicateObjectMap [
        rr:predicate rdfs:label;
        rr:objectMap [
            rr:language "en" ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
                    rr:predicate hrf:template ;
                    rr:objectMap [
                        rr:constant
                            "output of cmip5.{experiment}"
                    ]
                ] 
            ]
        ]
    ] ;
    
    rr:predicateObjectMap [
        rr:predicate data:holdsSpecializationOfVariable;
        rr:objectMap :VariableIRI
    ] ;

    rr:predicateObjectMap [
        rr:predicate top:hasComponent ;
        rr:objectMap [
            rr:parentTriplesMap :EnsembleOutputMapping
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate top:isComponentOf ;
        rr:object <https://w3id.org/hacid/data/cs/mips/cmip5/output>
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:isSpecializedAccordingTo ;
        rr:object geo_specialization_all:
    ] ;
    
    rr:predicateObjectMap [
        rr:predicate ccso:refersToScenario ;
        rr:objectMap :EmissionScenarioIRI
    ] .      

:ModelMapping a rr:TriplesMap ;
	rml:logicalSource :LogicalSource ;
	rr:subjectMap [
        rr:termType rr:IRI ;
        rr:class ccso:GlobalClimateModel ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant hrf:fromList ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate hrf:arr ;
                rr:objectMap [ rml:reference "model" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate hrf:ns ;
                rr:objectMap [ rr:constant "https://w3id.org/hacid/data/cs/models/" ]
            ] 
        ]
    ] ;

    rr:predicateObjectMap [
	    rr:predicate rdfs:label ;
	    rr:objectMap [
            rr:language "en" ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant hrf:eval ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate hrf:str ;
                    rr:objectMap [ rml:reference "model" ]
                ] 
            ]
        ]
    ] ;

    rr:predicateObjectMap [
	    rr:predicate ccso:isMaintainedBy ;
	    rr:objectMap :InstituteIRI
    ] .

:InstituteIRI
    rr:termType rr:IRI ;
    rr:class top:Organization ;
    fnml:functionValue [
        rr:predicateObjectMap [
            rr:predicate fno:executes ;
            rr:objectMap [ rr:constant hrf:fromList ]
        ] ;
        rr:predicateObjectMap [
            rr:predicate hrf:arr ;
            rr:objectMap [ rml:reference "institute" ]
        ] ;
        rr:predicateObjectMap [
            rr:predicate hrf:ns ;
            rr:objectMap [ rr:constant "https://w3id.org/hacid/data/cs/organizations/" ]
        ] 
    ].

:InstituteMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;

    rr:subjectMap :InstituteIRI ;

    rr:predicateObjectMap [
        rr:predicate top:acronym ;
        rr:objectMap :InstituteAcronym
    ] .

:InstituteAcronym
    fnml:functionValue [
        rr:predicateObjectMap [
            rr:predicate fno:executes ;
            rr:objectMap [ rr:constant hrf:eval ]
        ] ;
        rr:predicateObjectMap [
            rr:predicate hrf:str ;
            rr:objectMap [ rml:reference "institute" ]
        ] 
    ].

:FormatTemporalGridCall
    rr:predicate fno:executes ;
    rr:objectMap [ rr:constant hrf:formatTemporalGrid ] .

:ParamDatetimeStart
    rr:predicate hrf:startDatetime ;
    rr:objectMap [ rml:reference "datetime_start" ] .

:ParamDatetimeStop
    rr:predicate hrf:endDatetime ;
    rr:objectMap [ rml:reference "datetime_stop" ] .

:ParamGranularity
    rr:predicate hrf:granularity ;
    rr:objectMap [ rml:reference "time_frequency" ] .

:TemporalSpecializationMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;

    rr:subjectMap [
        rr:termType rr:IRI ;
        rr:class data:VariableSpecialization ;
        fnml:functionValue [
            rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                rr:predicate hrf:template ;
                rr:objectMap [
                    rr:constant "https://w3id.org/hacid/data/cs/dimensions/time/reference-frames/gregorian/regions/{start_datetime}-{end_datetime}/specialization"
                ]
            ] 
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:isSpecializationOn ;
        rr:object dimension:time
    ] ; 

    rr:predicateObjectMap [
        rr:predicate data:hasSelectedRegion ;
        rr:objectMap [ 
            rr:parentTriplesMap :TemporalRegionMapping
        ]
    ] .

:TimeVariableMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;

    rr:subjectMap [
        rr:termType rr:IRI ;
        rr:class data:DimensionalSpace ;
        fnml:functionValue [
            rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                rr:predicate hrf:template ;
                rr:objectMap [
                    rr:constant "https://w3id.org/hacid/data/cs/dimensions/time/reference-frames/gregorian/regions/{start_datetime}-{end_datetime}/quantized/{grid_type_id}"
                ]
            ] 
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:basedOnDimensionalSpace ;
        rr:object time:gregorian
    ] ; 

    rr:predicateObjectMap [
        rr:predicate data:hasDiscretization ;
        rr:objectMap [ 
            rr:parentTriplesMap :TimeQuantizationMapping
        ]
    ] ; 

    rr:predicateObjectMap [
        rr:predicate data:hasExactBoundingRegion ;
        rr:objectMap [ 
            rr:parentTriplesMap :TemporalRegionMapping
        ]
    ] .

:TimeQuantizationMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;

    rr:subjectMap [
        rr:termType rr:IRI ;
#        rr:class data:Quantization ;
        fnml:functionValue [
            rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                rr:predicate hrf:template ;
                rr:objectMap [ rr:constant "https://w3id.org/hacid/data/cs/dimensions/time/reference-frames/gregorian/quantizations/{grid_type_id}" ]
            ] 
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:basedOnDimensionalSpace ;
        rr:object dimension:time
    ] ; 

    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ 
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                    rr:predicate hrf:template ;
                    rr:objectMap [ rr:constant "https://w3id.org/hacid/onto/data/{dimensional_space_type}" ]
                ]
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:hasResolutionValue ;
        rr:objectMap [ 
            rr:datatype xsd:duration ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                    rr:predicate hrf:template ;
                    rr:objectMap [ rr:constant "{grid_step}" ]
                ]
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:hasPeriodValue ;
        rr:objectMap [ 
            rr:datatype xsd:duration ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                    rr:predicate hrf:template ;
                    rr:objectMap [ rr:constant "{grid_period}" ]
                ]
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:hasInPeriodResolutionValue ;
        rr:objectMap [ 
            rr:datatype xsd:duration ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                    rr:predicate hrf:template ;
                    rr:objectMap [ rr:constant "{grid_in_period_step}" ]
                ]
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:hasOffsetValue ;
        rr:objectMap [ 
            rr:datatype xsd:duration ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                    rr:predicate hrf:template ;
                    rr:objectMap [ rr:constant "{grid_offset}" ]
                ]
            ]
        ]
    ] .

:TemporalRegionMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;

    rr:subjectMap [
        rr:termType rr:IRI ;
        rr:class data:TemporalRegion ;
        fnml:functionValue [
            rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                rr:predicate hrf:template ;
                rr:objectMap [ rr:constant "https://w3id.org/hacid/data/cs/dimensions/time/reference-frames/gregorian/regions/{start_datetime}-{end_datetime}" ]
            ] 
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:hasStartDateTime ;
        rr:objectMap [ 
            rr:datatype xsd:dateTime ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                    rr:predicate hrf:template ;
                    rr:objectMap [ rr:constant "{start_datetime}" ]
                ]
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:hasEndDateTime ;
        rr:objectMap [ 
            rr:datatype xsd:dateTime ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                    rr:predicate hrf:template ;
                    rr:objectMap [ rr:constant "{end_datetime}" ]
                ]
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ 
            rr:language "en" ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                    rr:predicate hrf:template ;
                    rr:objectMap [ rr:constant "Time interval {start_datetime} - {end_datetime}" ]
                ] 
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:comment ;
        rr:objectMap [ 
            rr:language "en" ;
            fnml:functionValue [
                rr:predicateObjectMap :FormatTemporalGridCall, :ParamDatetimeStart, :ParamDatetimeStop, :ParamGranularity, [
                    rr:predicate hrf:template ;
                    rr:objectMap [ rr:constant "Time interval starting at date time {start_datetime} and ending at date time {end_datetime}." ]
                ] 
            ]
        ]
    ] .

:SpaceVariableMapping a rr:TriplesMap ;
    rml:logicalSource :LogicalSource ;

    rr:subjectMap [
        rr:termType rr:IRI ;
        rr:class data:DimensionalSpace ;
        fnml:functionValue [
            rr:predicateObjectMap :FormatDatasetCall, :ParamMasterId, [
                rr:predicate hrf:template ;
                rr:objectMap [
                    rr:constant
                        "https://w3id.org/hacid/data/cs/simulations/cmip5.{model}.{experiment}.{ensemble}/geodetic-grid"
                ]
            ] 
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate data:basedOnDimensionalSpace ;
        rr:object geodetic:WGS84
    ] ; 

    rr:predicateObjectMap [
        rr:predicate data:hasExactBoundingRegion ;
        rr:object <https://w3id.org/hacid/data/cs/dimensions/geodetic/all>
    ] .

:VariableIRI
    rr:termType rr:IRI ;
    rr:class data:Variable, data:DependentVariable ;
    fnml:functionValue [
        rr:predicateObjectMap [
            rr:predicate fno:executes ;
            rr:objectMap [ rr:constant hrf:fromList ]
        ] ;
        rr:predicateObjectMap [
            rr:predicate hrf:arr ;
            rr:objectMap [ rml:reference "variable" ]
        ] ;
        rr:predicateObjectMap [
            rr:predicate hrf:ns ;
            rr:objectMap [ rr:constant "https://w3id.org/hacid/data/cs/variables/mip/" ]
        ] 
    ].
