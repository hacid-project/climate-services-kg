@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix data: <https://w3id.org/hacid/onto/data/> .
@prefix ccso: <https://w3id.org/hacid/onto/ccso/> .

# Provisional terms used by the mappings, not yet in the ontologies
# (data.owl, ccso.owl). To be moved there (or replaced) when defined.
# (The terms for linear transformations and distribution representations are
# now in data.owl; the return levels are derived from their variables,
# data:derivedFromVariable.)

<https://w3id.org/hacid/onto/provisional> a owl:Ontology ;
    rdfs:comment "Provisional terms used by the mappings of the climate services KG, not yet in the HACID ontologies."@en .

# --- Anomalies

ccso:Anomaly a owl:Class ;
    rdfs:subClassOf data:Variable ;
    rdfs:label "anomaly"@en ;
    rdfs:comment "Variable whose values are the changes of the values of another variable with respect to a baseline, usually its climatology over a baseline period."@en .

ccso:AbsoluteAnomaly a owl:Class ;
    rdfs:subClassOf ccso:Anomaly ;
    rdfs:label "absolute anomaly"@en ;
    rdfs:comment "Anomaly whose values are the differences from the baseline."@en .

ccso:RelativeAnomaly a owl:Class ;
    rdfs:subClassOf ccso:Anomaly ;
    owl:disjointWith ccso:AbsoluteAnomaly ;
    rdfs:label "relative anomaly"@en ;
    rdfs:comment "Anomaly whose values are the differences from the baseline relative to the baseline (e.g. as a percentage)."@en .

ccso:isAnomalyOf a owl:ObjectProperty ;
    rdfs:subPropertyOf data:derivedFromVariable ;
    rdfs:domain ccso:Anomaly ;
    rdfs:range data:Variable ;
    rdfs:label "is anomaly of"@en ;
    rdfs:comment "Associates an anomaly with the variable of which it is the anomaly."@en .

ccso:hasBaselinePeriod a owl:ObjectProperty ;
    rdfs:domain ccso:Anomaly ;
    rdfs:range data:TemporalRegion ;
    rdfs:label "has baseline period"@en ;
    rdfs:comment "Associates an anomaly with the period of the baseline (e.g. the climatology over 1981-2000) with respect to which it is computed."@en .
