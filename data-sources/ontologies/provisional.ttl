@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix data: <https://w3id.org/hacid/onto/data/> .
@prefix ccso: <https://w3id.org/hacid/onto/ccso/> .

# Provisional terms used by the mappings, not yet in the ontologies
# (data.owl, ccso.owl). To be moved there (or replaced) when defined.

<https://w3id.org/hacid/onto/provisional> a owl:Ontology ;
    rdfs:comment "Provisional terms used by the mappings of the climate services KG, not yet in the HACID ontologies."@en .

# --- Relations between variables

data:isLinearTransformationOf a owl:ObjectProperty ;
    rdfs:domain data:Variable ;
    rdfs:range data:Variable ;
    rdfs:label "is linear transformation of"@en ;
    rdfs:comment "The values of the variable are a linear transformation of the values of the other variable (e.g. the same quantity in other units)."@en .

data:hasOppositeValueOf a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain data:Variable ;
    rdfs:range data:Variable ;
    rdfs:label "has opposite value of"@en ;
    rdfs:comment "The values of the variable are the opposite of the values of the other variable (e.g. a flux in the opposite direction)."@en .

ccso:isAnomalyOf a owl:ObjectProperty ;
    rdfs:domain data:Variable ;
    rdfs:range data:Variable ;
    rdfs:label "is anomaly of"@en ;
    rdfs:comment "The variable is the anomaly (absolute change with respect to a baseline) of the other variable."@en .

ccso:isRelativeAnomalyOf a owl:ObjectProperty ;
    rdfs:domain data:Variable ;
    rdfs:range data:Variable ;
    rdfs:label "is relative anomaly of"@en ;
    rdfs:comment "The variable is the relative anomaly (change with respect to a baseline relative to the baseline, e.g. as a percentage) of the other variable."@en .

# --- Return levels

data:ReturnLevel a owl:Class ;
    rdfs:subClassOf data:Variable ;
    rdfs:label "return level"@en ;
    rdfs:comment "Variable whose values are the levels of another variable expected to be exceeded on average once in a return period."@en .

data:isReturnLevelOf a owl:ObjectProperty ;
    rdfs:domain data:ReturnLevel ;
    rdfs:range data:Variable ;
    rdfs:label "is return level of"@en ;
    rdfs:comment "The return level is of the levels of the other variable."@en .

data:hasReturnPeriod a owl:DatatypeProperty ;
    rdfs:domain data:ReturnLevel ;
    rdfs:range xsd:duration ;
    rdfs:label "has return period"@en ;
    rdfs:comment "The return period of the return level."@en .

# --- Probability representations

data:ProbabilityRepresentation a owl:Class ;
    rdfs:subClassOf data:Variable ;
    rdfs:label "probability representation"@en ;
    rdfs:comment "Variable whose values represent the probability distribution of another variable."@en .

data:ProbabilityDensityFunction a owl:Class ;
    rdfs:subClassOf data:ProbabilityRepresentation ;
    rdfs:label "probability density function"@en ;
    rdfs:comment "Probability representation whose values are the probability densities of the values of the other variable."@en .

data:CumulativeDistributionFunction a owl:Class ;
    rdfs:subClassOf data:ProbabilityRepresentation ;
    rdfs:label "cumulative distribution function"@en ;
    rdfs:comment "Probability representation given by the cumulative distribution of the other variable, e.g. its values at given percentiles."@en .

data:ProbabilisticSample a owl:Class ;
    rdfs:subClassOf data:ProbabilityRepresentation ;
    rdfs:label "probabilistic sample"@en ;
    rdfs:comment "Probability representation whose values are a sample drawn from the probability distribution of the other variable."@en .

data:isProbabilityRepresentationOf a owl:ObjectProperty ;
    rdfs:domain data:ProbabilityRepresentation ;
    rdfs:range data:Variable ;
    rdfs:label "is probability representation of"@en ;
    rdfs:comment "The probability representation represents the probability distribution of the other variable."@en .
